<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- KillerNotes half of the Mourning theme. Shared contract tokens live in
         KillerUI/Themes/Mourning.xaml; only app-specific resources belong here.
         Flattened from the former RetroPaletteCatalog generator, whose source palette
         was ["#ffb199", "#ff6f91", "#f9f871", "#a0ffe6", "#4b4453"]; Mourning pinned
         most of its roles by hand, so almost nothing here was derived. -->
    <sys:Double x:Key="GrainOpacity">0.32</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="TextFooter"            Color="#a0ffe6" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#c85c77" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"         Color="#f4f4f0" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush"   Color="#c15a74" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#a0ffe6" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#a0ffe6" po:Freeze="True"/>

    <SolidColorBrush x:Key="BgCanvas"              Color="#554c5d" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"         Color="#3c3841" po:Freeze="True"/>
    <SolidColorBrush x:Key="SortButtonBrush"       Color="#554c5d" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"            Color="#ff6f91" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"       Color="#a0ffe6" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"           Color="#f9f871" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"             Color="#dd4641" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"           Color="#cf5f7a" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"     Color="#b2556c" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"             Color="#a0ffe6" po:Freeze="True"/>
    <SolidColorBrush x:Key="OkBrush"               Color="#ffb199" po:Freeze="True"/>

    <!-- Shortcut-overlay category colours (the family neon set, shared with the website map) -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#39ff14" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#ff901f" po:Freeze="True"/>
</ResourceDictionary>
