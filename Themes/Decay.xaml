<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- KillerNotes half of the Decay theme. Shared contract tokens live in
         KillerUI/Themes/Decay.xaml; only app-specific resources belong here. Flattened
         from the former Cyanotic-plus-patch form so this theme stands alone. -->
    <sys:Double x:Key="GrainOpacity">0.30</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="TextFooter"            Color="#c2b280" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#6b705c" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"         Color="#f2f4f3" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush"   Color="#777b68" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#aa6b705c" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8a7f72" po:Freeze="True"/>

    <SolidColorBrush x:Key="BgFlyout"              Color="#3b3f46" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"         Color="#4b4944" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgCanvas"              Color="#403f3b" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"            Color="#d2c58f" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"       Color="#8fa88d" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"           Color="#b8aa7c" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"             Color="#9b5550" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"           Color="#8a7f72" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"     Color="#8d8768" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"             Color="#9a6b24" po:Freeze="True"/>
    <SolidColorBrush x:Key="OkBrush"               Color="#8fa88d" po:Freeze="True"/>
    <SolidColorBrush x:Key="SortButtonBrush"       Color="#403f3b" po:Freeze="True"/>

    <!-- Shortcut-overlay category colours (the family neon set, shared with the website map) -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#39ff14" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#ff901f" po:Freeze="True"/>

    <!-- Device-type swatches (inherited from the shared palette set) -->
    <SolidColorBrush x:Key="TypeRouter"     Color="#F0A030" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeWindows"    Color="#8FC4FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypePrinter"    Color="#D080A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSwitch"     Color="#C0C0C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHypervisor" Color="#E06060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeNas"        Color="#40C080" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeIot"        Color="#A24FD8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeServer"     Color="#E08050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeLinux"      Color="#D0C050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDns"        Color="#50B0D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHa"         Color="#50D0A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMobile"     Color="#A0A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCamera"     Color="#F0C060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSmarttv"    Color="#E0A0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMedia"      Color="#70C0E0" po:Freeze="True"/>
</ResourceDictionary>
