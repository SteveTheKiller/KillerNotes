    <SolidColorBrush x:Key="OutlinePressedBrush"   Color="#777b68" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#55b8aa7c" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#b8aa7c" po:Freeze="True"/>

    <SolidColorBrush x:Key="BgFlyout"              Color="#3b3f46" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"         Color="#4b4944" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgCanvas"              Color="#403f3b" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"            Color="#d2c58f" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"       Color="#8fa88d" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"           Color="#b8aa7c" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"             Color="#9b5550" po:Freeze="True"/>
