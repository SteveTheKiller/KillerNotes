<!-- KillerNotes' own theme values: keys only KillerNotes' views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the Malaise values over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="BgRecentPanel"         Color="#394340" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgCanvas"              Color="#343b3d" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"     Color="#c2b280" po:Freeze="True"/>
    <!-- Shortcut-overlay category colors (the family neon set, shared with the website map) -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#39ff14" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#ff901f" po:Freeze="True"/>
    <SolidColorBrush x:Key="ContentPaneBrush" Color="#303638" po:Freeze="True"/>
    <!-- The notes list lets the chrome strip show through, as on every other theme. The family
         Malaise paints KillerShell's list pane under the same name. -->
    <SolidColorBrush x:Key="ListPaneBrush" Color="#00FFFFFF" po:Freeze="True"/>
    <!-- The slider track KillerNotes reviewed for contrast against the menu surface (KN-P08). The
         family track follows the input edge, which reads too faint on Dark. Proposed to KillerUI. -->
    <SolidColorBrush x:Key="SliderTrack"           Color="#8a7f72" po:Freeze="True"/>
</ResourceDictionary>
