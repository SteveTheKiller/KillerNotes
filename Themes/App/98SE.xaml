<!-- KillerNotes' own theme values: keys only KillerNotes' views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the 98SE values over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="CaptionPressedTextBrush" Color="#000000"/>
    <FontFamily x:Key="SidebarFont">Microsoft Sans Serif</FontFamily>
    <SolidColorBrush x:Key="BgRecentPanel"         Color="#c0c0c0" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgCanvas"              Color="#ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"     Color="#a0a0a0" po:Freeze="True"/>
    <!-- Shortcut-overlay category colors (the family neon set, shared with the website map) -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#009e99" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#d1105a" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#a67c00" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#a316b5" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#0077b3" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#128c07" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#cc6a00" po:Freeze="True"/>
    <!-- The graph's canvas. Everywhere else this defaults to BackgroundBrush so the caption and
         the field read as one surface; 98SE has a real blue caption band, so its client area
         belongs on white like the note list and every other Win98 app. -->
    <SolidColorBrush x:Key="GraphCanvasBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="TitleMetaBrush" Color="#ffffff" />
    <!-- KillerNotes' own 98SE layout for its main window and file picker: the format bar, editor
         pane, footer, notes list and frame. The family template carries KillerShell's values
         under the same names; these keep KillerNotes' views as they were. -->
    <SolidColorBrush x:Key="BarEdgeBrush" Color="#ffffff" />
    <Thickness x:Key="BarEdgeThickness">1,1,0,0</Thickness>
    <Thickness x:Key="BarPadding">3</Thickness>
    <Thickness x:Key="ContentPaneMargin">0,5,0,0</Thickness>
    <Thickness x:Key="PickerContentMargin">3</Thickness>
    <Thickness x:Key="PickerButtonsMargin">3,4,3,4</Thickness>
    <sys:Double x:Key="EditorSelectionOpacity">0.75</sys:Double>
    <SolidColorBrush x:Key="FooterBevelDarkBrush" Color="#808080" />
    <SolidColorBrush x:Key="FooterBevelLightBrush" Color="#ffffff" />
    <Thickness x:Key="FooterPadding">0,0,-2,0</Thickness>
    <SolidColorBrush x:Key="ListPaneBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="SearchFieldBrush" Color="#ffffff" />
    <Thickness x:Key="SidebarPanelMargin">0,5,0,0</Thickness>
    <Thickness x:Key="TitleBarBleed">-1,0,-1,0</Thickness>
    <Thickness x:Key="TitleBarPadding">4,2,0,0</Thickness>
    <LinearGradientBrush x:Key="WindowFrameBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#cbcbcb" Offset="0" /><GradientStop Color="#bcbcbc" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="WindowFramePadding">5,4,5,5</Thickness>
    <sys:Double x:Key="WordmarkEmbossOpacity">1</sys:Double>
    <!-- KillerNotes' registered palette exceptions (KillerHarness/family/theme-contract.json). -->
    <SolidColorBrush x:Key="PaneBrush" Color="#ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#c0c0c0" po:Freeze="True"/>
</ResourceDictionary>
