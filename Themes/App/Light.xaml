<!-- KillerNotes' own theme values: keys only KillerNotes' views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the Light values over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Keyboard-map category colors (F1 overlay KEYBOARD view): darker variants of the
         product palette so they read on light keycaps -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#009e99" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#d1105a" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#a67c00" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#a316b5" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#0077b3" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#128c07" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#cc6a00" po:Freeze="True"/>
    <!-- Nothing white: chrome #cccccc, menus, bars and side panes #d6d6d6, the note and
         panels #e0e0e0, fields #e6e6e6. Each step is a reasonable gray, not paper. -->
    <SolidColorBrush x:Key="ContentPaneBrush" Color="#FFE0E0E0" po:Freeze="True"/>
    <!-- The slider track KillerNotes reviewed for contrast against the menu surface (KN-P08). The
         family track follows the input edge, which reads too faint on Dark. Proposed to KillerUI. -->
    <SolidColorBrush x:Key="SliderTrack" Color="#8c8c8c" po:Freeze="True"/>
</ResourceDictionary>
