<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <CornerRadius x:Key="WindowCornerRadius">7</CornerRadius><CornerRadius x:Key="PanelCornerRadius">6</CornerRadius><CornerRadius x:Key="ControlCornerRadius">4</CornerRadius><CornerRadius x:Key="SmallCornerRadius">3</CornerRadius><CornerRadius x:Key="FlyoutCornerRadius">0,0,4,4</CornerRadius><CornerRadius x:Key="AccentSwatchCornerRadius">9</CornerRadius>
  <!-- Syntax highlighting. The code defaults to the VS Code Dark+ palette, which is built for a
       near-black editor: on this theme's light page its number green (#B5CEA8) and comment green
       (#6A9955) sit around 1.8:1 and read as a watermark rather than as text. These are the
       Light+ equivalents - the same seven roles, picked for a light background. The eleven
       dark-paged themes state nothing and keep Dark+. (Steve, 2026-08-07.) -->
  <SolidColorBrush x:Key="Syn_Comment"  Color="#008000"/>
  <SolidColorBrush x:Key="Syn_String"   Color="#a31515"/>
  <SolidColorBrush x:Key="Syn_Number"   Color="#098658"/>
  <SolidColorBrush x:Key="Syn_Variable" Color="#001080"/>
  <SolidColorBrush x:Key="Syn_Type"     Color="#267f99"/>
  <SolidColorBrush x:Key="Syn_Operator" Color="#af00db"/>
  <SolidColorBrush x:Key="Syn_Keyword"  Color="#0000ff"/>
  <SolidColorBrush x:Key="TitleBarBrush" Color="#dcdcdc"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#dcdcdc"/><SolidColorBrush x:Key="SurfaceBrush" Color="#f0f0f0"/><SolidColorBrush x:Key="PaneBrush" Color="#e8e8e8"/><SolidColorBrush x:Key="TableHeaderBrush" Color="#f0f0f0"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#14000000"/><SolidColorBrush x:Key="RowHoverBrush" Color="#b2b2b2"/><SolidColorBrush x:Key="MenuHoverBrush" Color="#b2b2b2"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#c0c0c0"/><SolidColorBrush x:Key="PaneBorderBrush" Color="#b0b0b0"/><SolidColorBrush x:Key="AppBorderBrush" Color="#b0b0b0"/>
  <SolidColorBrush x:Key="TextBrush" Color="#1a1a1a"/><SolidColorBrush x:Key="MutedTextBrush" Color="#555555"/><SolidColorBrush x:Key="ChromeTextBrush" Color="#3a3a3a"/><SolidColorBrush x:Key="DimTextBrush" Color="#666666"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#b0b0b0"/><SolidColorBrush x:Key="InputHoverBrush" Color="#8a8a8a"/><SolidColorBrush x:Key="MenuBackgroundBrush" Color="#ffffff"/><SolidColorBrush x:Key="MenuBorderBrush" Color="#b0b0b0"/>
  <SolidColorBrush x:Key="SelectionBg" Color="#1b5e20"/><SolidColorBrush x:Key="SelectionFg" Color="#ffffff"/><SolidColorBrush x:Key="PrimaryBrush" Color="#1b5e20"/><SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1b5e20"/><SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1b5e20"/><SolidColorBrush x:Key="OnPrimaryBrush" Color="#ffffff"/><SolidColorBrush x:Key="OutlineBtnBrush" Color="#1b5e20"/><SolidColorBrush x:Key="HeaderLineBrush" Color="#1b5e20"/>
</ResourceDictionary>
