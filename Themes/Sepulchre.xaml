<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- KillerNotes half of the Sepulchre theme. Shared contract tokens live in
         KillerUI/Themes/Sepulchre.xaml; only app-specific resources belong here.
         Flattened from the former RetroPaletteCatalog generator, whose source palette
         was ["#292d2f", "#347c80", "#986632", "#705827"] with a pinned #4faaa8 accent. -->
    <sys:Double x:Key="GrainOpacity">0.32</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="TextFooter"            Color="#e2e4e0" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#448988" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"         Color="#f4f4f0" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush"   Color="#438584" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#b4347c80" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#347c80" po:Freeze="True"/>

    <SolidColorBrush x:Key="BgCanvas"              Color="#3a352f" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"         Color="#2e3134" po:Freeze="True"/>
    <SolidColorBrush x:Key="SortButtonBrush"       Color="#347c80" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"            Color="#6fb9b8" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"       Color="#347c80" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"           Color="#705827" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"             Color="#dd4641" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"           Color="#30696d" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"     Color="#407b7b" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"             Color="#705827" po:Freeze="True"/>
    <SolidColorBrush x:Key="OkBrush"               Color="#292d2f" po:Freeze="True"/>

    <!-- Shortcut-overlay category colors (the family neon set, shared with the website map) -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#39ff14" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#ff901f" po:Freeze="True"/>
</ResourceDictionary>
