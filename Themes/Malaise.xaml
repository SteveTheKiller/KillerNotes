    <SolidColorBrush x:Key="MenuTextBrush"         Color="#f2f4f3" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush"   Color="#586c66" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#55ff6f91" po:Freeze="True"/>
