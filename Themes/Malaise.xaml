<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- KillerNotes half of the Malaise theme. The shared contract tokens (window,
         surface, pane, text, menu, selection, primary) live in KillerUI/Themes/Malaise.xaml
         and are overlaid by KillerThemeContract; only app-specific resources belong here.
         Flattened from the former Cyanotic-plus-patch form so this theme stands alone
         exactly like Dark, Light and the rest. -->
    <sys:Double x:Key="GrainOpacity">0.30</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="TextFooter"            Color="#a0ffe6" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#365b58" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"         Color="#f2f4f3" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush"   Color="#586c66" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#aa6b705c" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8a7f72" po:Freeze="True"/>

    <SolidColorBrush x:Key="BgRecentPanel"         Color="#394340" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgCanvas"              Color="#343b3d" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"            Color="#ff6f91" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"       Color="#a0ffe6" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"           Color="#f9f871" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"             Color="#ff6f91" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"           Color="#8a7f72" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"     Color="#c2b280" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"             Color="#9a6b24" po:Freeze="True"/>
    <SolidColorBrush x:Key="OkBrush"               Color="#6b705c" po:Freeze="True"/>
    <SolidColorBrush x:Key="SortButtonBrush"       Color="#343b3d" po:Freeze="True"/>

    <!-- Shortcut-overlay category colors (the family neon set, shared with the website map) -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#39ff14" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#ff901f" po:Freeze="True"/>
</ResourceDictionary>
