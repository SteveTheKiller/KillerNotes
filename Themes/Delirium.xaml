<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- KillerNotes half of the Delirium theme. Shared contract tokens live in
         KillerUI/Themes/Delirium.xaml; only app-specific resources belong here.
         Flattened from the former RetroPaletteCatalog generator, whose source palette
         was ["#cf1020", "#3a2b78", "#20a8b5", "#5fce00", "#9a9b00", "#dd8500"]. -->
    <sys:Double x:Key="GrainOpacity">0.32</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">1.0</sys:Double>

    <SolidColorBrush x:Key="TextFooter"            Color="#e2e4e0" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#ae6d0a" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"         Color="#f4f4f0" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush"   Color="#a96a0b" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#b4dd8500" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#dd8500" po:Freeze="True"/>

    <SolidColorBrush x:Key="BgCanvas"              Color="#343344" po:Freeze="True"/>
    <SolidColorBrush x:Key="BgRecentPanel"         Color="#2e3134" po:Freeze="True"/>
    <SolidColorBrush x:Key="SortButtonBrush"       Color="#2a2c2f" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo"            Color="#e39b2e" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent"       Color="#dd8500" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"           Color="#5fce00" po:Freeze="True"/>
    <SolidColorBrush x:Key="DangerRed"             Color="#dd4641" po:Freeze="True"/>
    <SolidColorBrush x:Key="SliderTrack"           Color="#352a66" po:Freeze="True"/>
    <SolidColorBrush x:Key="SettingsOpenRowBg"     Color="#9c630e" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"             Color="#5fce00" po:Freeze="True"/>
    <SolidColorBrush x:Key="OkBrush"               Color="#cf1020" po:Freeze="True"/>

    <!-- Shortcut-overlay category colours (the family neon set, shared with the website map) -->
    <SolidColorBrush x:Key="KnCatFile"   Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatNote"   Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatFormat" Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatView"   Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatSearch" Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatHelp"   Color="#39ff14" po:Freeze="True"/>
    <SolidColorBrush x:Key="KnCatEdit"   Color="#ff901f" po:Freeze="True"/>
</ResourceDictionary>
