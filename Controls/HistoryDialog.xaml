<!-- Version history (1.3.1): the earlier versions of one note, newest first, with a read-only
     preview of the selected one and a Restore button. Same dialog chrome as DatabasesDialog
     and TagsDialog; the two panes use the same client-area treatment as their lists. -->
<Window x:Class="KillerNotes.Controls.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        Width="820" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. One copy each, in Controls.xaml and
         DialogTitleBar.xaml - never inline them here again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar Grid.Row="0" Subtitle="{DynamicResource Str_Hist_Title}"
                                      CloseRequested="Close_Click"/>

                <!-- Body: versions on the left, the selected one on the right. -->
                <Grid Grid.Row="1" Margin="24,16,24,12" Height="440">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Versions list: a CLIENT AREA, same treatment as the Databases and Tags
                         lists. Bevels are siblings in the Grid, never children of the bordered
                         element; the grain goes OVER the rows, last. -->
                    <Grid Grid.Column="0">
                        <Border IsHitTestVisible="False" Background="{DynamicResource PaneBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Effect="{DynamicResource PaneShadowEffect}"/>
                        <Border Background="{DynamicResource PaneBrush}"
                                BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <ListBox x:Name="VersionList" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" Margin="4"
                                     SelectionChanged="VersionList_SelectionChanged"
                                     MouseDoubleClick="VersionList_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bg" Background="Transparent"
                                                            CornerRadius="{DynamicResource SmallCornerRadius}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <!-- Rows are built in code (HistoryDialog.xaml.cs Refresh). -->
                            </ListBox>
                        </Border>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}"
                                Background="{DynamicResource GrainTileBrush}"/>
                    </Grid>

                    <!-- Preview: the selected version, read-only, in the live theme's colors.
                         Same client-area chrome as the list. -->
                    <Grid Grid.Column="2">
                        <Border IsHitTestVisible="False" Background="{DynamicResource PaneBrush}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Effect="{DynamicResource PaneShadowEffect}"/>
                        <Border Background="{DynamicResource PaneBrush}"
                                BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Grid>
                                <RichTextBox x:Name="Preview" IsReadOnly="True" IsDocumentEnabled="False"
                                             Background="Transparent" BorderThickness="0" Margin="8"
                                             Foreground="{DynamicResource TextBrush}"
                                             FontFamily="{DynamicResource ContentFont}" FontSize="13"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"/>
                                <TextBlock x:Name="EmptyText" Text="{DynamicResource Str_Hist_Empty}"
                                           Foreground="{DynamicResource DimTextBrush}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="40" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                </Grid>

                <!-- Footer: count on the left, Restore on the right. -->
                <Grid Grid.Row="2" Margin="24,0,24,18">
                    <TextBlock x:Name="DlgStatus" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,120,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- OutlineButton (family standard): accent outline, fills solid on hover -->
                        <Button x:Name="RestoreBtn" Content="{DynamicResource Str_Btn_RestoreVersion}" Click="Restore_Click"
                                Style="{StaticResource OutlineButton}" MinWidth="120" Padding="14,5" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </ContentControl>
</Window>
