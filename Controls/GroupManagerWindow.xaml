<!-- The group manager (1.7.0, Shell/GroupManager.cs): the groups as a tree on the left, the
     selected group's notes as a sortable table on the right, one search box over both. Drag
     notes onto a group to file them, drag a group onto another to nest it. Every change runs
     the sidebar's own code through IGroupManagerHost, so Ctrl+Z in either window undoes it.
     A reference window like the graph: owner-less, in the taskbar, resizable. Right-click opens
     the sidebar's own group card or note card (IGroupManagerHost.ShowGroupCard / ShowNoteCard). -->
<Window x:Class="KillerNotes.Controls.GroupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="{DynamicResource Str_Mgr_Title}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Width="820" Height="620" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="True">
    <!-- WindowChrome and the halo are set in code (UpdateChrome): 20px of halo on rounded
         themes, flush on 98SE, the same as the graph and sketch pad windows. -->

    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Subtitle="{DynamicResource Str_Mgr_Subtitle}"
                                  CloseRequested="Close_Click"/>

            <!-- Search over both panes, and a new group under the selected one. -->
            <DockPanel Grid.Row="1" Margin="16,10,16,8" LastChildFill="True">
                <Button x:Name="NewGroupBtn" DockPanel.Dock="Right" Style="{StaticResource SurfaceButton}" Margin="10,0,0,0"
                        Padding="12,4" Click="NewGroup_Click" AutomationProperties.Name="{DynamicResource Str_Mgr_NewGroup}"
                        ToolTip="{DynamicResource Str_Mgr_NewGroup}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str_Mgr_NewGroup}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Grid>
                    <TextBox x:Name="SearchBox" Height="28" VerticalContentAlignment="Center" Padding="26,0,8,0"
                             TextChanged="SearchBox_TextChanged" AutomationProperties.Name="{DynamicResource Str_Mgr_Search}"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="9,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" Foreground="{DynamicResource DimTextBrush}"/>
                    <TextBlock x:Name="SearchHint" Text="{DynamicResource Str_Mgr_Search}" Margin="28,0,0,0" IsHitTestVisible="False"
                               VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource DimTextBrush}"/>
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- Groups. "All notes" and "No group" sit above the real tree; dropping a group on
                     either moves it to the top level, dropping notes on "No group" ungroups them. -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource PaneBrush}">
                    <TreeView x:Name="Tree" Style="{StaticResource FolderTreeView}" AllowDrop="True" Padding="4"
                              AutomationProperties.Name="{DynamicResource Str_Mgr_Groups}"
                              SelectedItemChanged="Tree_SelectedItemChanged" KeyDown="Tree_KeyDown"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown" PreviewMouseMove="Tree_PreviewMouseMove"
                              DragOver="Tree_DragOver" Drop="Tree_Drop"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown" MouseRightButtonUp="Tree_MouseRightButtonUp">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:GroupNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="2,0,8,0"
                                               VerticalAlignment="Center" Foreground="{Binding GlyphBrush}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CountDisplay}" FontSize="11" Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
                <Border Grid.Column="0" Margin="1" Panel.ZIndex="1" IsHitTestVisible="False"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>

                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"
                              Focusable="False"/>

                <!-- Notes in the selected group: a header row of sort buttons over a list whose rows
                     share its columns. Multi-select with Ctrl and Shift, then drag onto a group. -->
                <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource PaneBrush}">
                    <DockPanel>
                        <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Margin="12,6,18,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <!-- No Group column: the tree on the left already says which group this is. -->
                            <Button x:Name="SortTitleBtn" Grid.Column="0" Style="{StaticResource MenuRowButton}" Tag="title" Click="Sort_Click"
                                    Content="{DynamicResource Str_Mgr_ColTitle}"/>
                            <Button x:Name="SortModifiedBtn" Grid.Column="1" Style="{StaticResource MenuRowButton}" Tag="modified" Click="Sort_Click"
                                    Content="{DynamicResource Str_Mgr_ColModified}"/>
                            <Button x:Name="SortTagsBtn" Grid.Column="2" Style="{StaticResource MenuRowButton}" Tag="tags" Click="Sort_Click"
                                    Content="{DynamicResource Str_Mgr_ColTags}"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Margin="8,0" Background="{DynamicResource CardBorderBrush}"/>
                        <Grid>
                            <ListBox x:Name="Table" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                     Padding="4"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     AutomationProperties.Name="{DynamicResource Str_Mgr_Notes}"
                                     PreviewMouseLeftButtonDown="Table_PreviewMouseLeftButtonDown" PreviewMouseMove="Table_PreviewMouseMove"
                                     MouseDoubleClick="Table_MouseDoubleClick" KeyDown="Table_KeyDown"
                                     PreviewMouseRightButtonDown="Table_PreviewMouseRightButtonDown" MouseRightButtonUp="Table_MouseRightButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PickerRow}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NoteRowItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorBrush}"/>
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ModifiedDisplay}" Opacity="0.75" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Tags}" TextTrimming="CharacterEllipsis" Opacity="0.75"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyText" Text="{DynamicResource Str_Mgr_Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimTextBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Margin="1" Panel.ZIndex="1" IsHitTestVisible="False"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
