<!-- Quick note (1.6.0, KN-P04): one box for a thought, saved to the open notepad without
     opening the main window. Shell/QuickNote.cs drives it; this is only the surface. Same card
     chrome as the other dialogs, but owner-less and in the taskbar, because it opens while the
     main window is closed to the tray. -->
<Window x:Class="KillerNotes.Controls.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="{DynamicResource Str_Quick_Title}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="True">

    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <local:DialogTitleBar x:Name="TitleBar" Grid.Row="0" Subtitle="{DynamicResource Str_Quick_Title}"
                                  CloseRequested="Close_Click"/>

            <StackPanel Grid.Row="1" Margin="20,14,20,10">
                <!-- Why nothing can be saved right now (locked, read-only, no notepad, too big). The
                     text box stays editable, so the draft is never lost. -->
                <Grid x:Name="Banner" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource DimTextBrush}" AutomationProperties.LiveSetting="Assertive"/>
                    <Button x:Name="UnlockBtn" Grid.Column="1" Content="{DynamicResource Str_Btn_Unlock}" Click="Unlock_Click"
                            Style="{StaticResource SurfaceButton}" Padding="12,0" Height="26" Margin="10,0,0,0" Visibility="Collapsed"/>
                </Grid>

                <TextBox x:Name="NoteBox" Style="{StaticResource EditFieldTextBox}" FontSize="13" Padding="6,4"
                         Height="170" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         AutomationProperties.Name="{DynamicResource Str_Quick_Title}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TargetLabel" Text="{DynamicResource Str_Quick_SaveTo}" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="TargetBox" Grid.Column="1" Style="{StaticResource KnCombo}"
                              ItemContainerStyle="{StaticResource KnComboItem}" Height="26"
                              AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2" Margin="20,0,20,16">
                <Button x:Name="PasteBtn" Content="{DynamicResource Str_Quick_Paste}" Click="Paste_Click" HorizontalAlignment="Left"
                        Style="{StaticResource SurfaceButton}" Padding="12,0" Height="28"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseBtn" Content="{DynamicResource Str_Btn_Cancel}" Click="Close_Click"
                            Style="{StaticResource SurfaceButton}" Width="80" Margin="0,0,8,0"/>
                    <Button x:Name="SaveBtn" Content="{DynamicResource Str_Btn_Save}" Click="Save_Click"
                            Style="{StaticResource OutlineButton}" Width="80"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
