<!-- Manage tags: add, rename, recolor (via the family color picker), and delete the
     per-database tag definitions. Same dialog chrome as DatabasesDialog. Deleting a tag
     removes it from every note; renaming rewrites it in every note (NoteStore). -->
<Window x:Class="KillerNotes.Controls.TagsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. One copy each, in Controls.xaml and
         DialogTitleBar.xaml - never inline them here again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar Grid.Row="0" Subtitle="{DynamicResource Str_Tags_Title}"
                                      CloseRequested="Close_Click"/>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24,16,24,12">
                    <!-- The "Manage tags" heading that used to sit here has moved into the
                         caption (DialogTitleBar Subtitle), same as DatabasesDialog. -->
                    <!-- The list is a CLIENT AREA, same treatment as DatabasesDialog's: square
                         corners from the theme rather than a hardcoded 4, and the crossed sunken
                         bevel so it reads as recessed into the card. Bevels are siblings in the
                         Grid, never children of the bordered element. -->
                    <Grid>
                    <!-- Elevation shadow on a childless sibling BEHIND the pane (family rule).
                         PaneShadowEffect, NEVER the keyed PaneShadow: its dynamic opacity does
                         not resolve reliably inside a shared Freezable and it cast a
                         full-strength shadow on 98SE; the theme-built effect is null there
                         (2026-08-08). -->
                    <Border IsHitTestVisible="False" Background="{DynamicResource PaneBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Effect="{DynamicResource PaneShadowEffect}"/>
                    <Border Background="{DynamicResource PaneBrush}"
                            BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ListBox x:Name="TagList" Height="200" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" Margin="4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <!-- The theme's radius, not a hardcoded 4: a list
                                                     row on a square-cornered theme is a square
                                                     selection bar (same rule as Databases). -->
                                                <Border x:Name="bg" Background="Transparent"
                                                        CornerRadius="{DynamicResource SmallCornerRadius}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <!-- Rows are built in code (TagsDialog.xaml.cs Refresh) so the
                                 swatch, name, and per-row buttons can carry the tag name. -->
                        </ListBox>
                    </Border>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                            BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}"
                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    <!-- Pane grain OVER the rows, LAST (the locked menu rule) - this is where the
                         dialog's texture lives, never in a card-wide overlay that would blanket
                         the edit fields. -->
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Opacity="{DynamicResource GrainOpacity}"
                            Background="{DynamicResource GrainTileBrush}"/>
                    </Grid>

                    <!-- Add row: name box + color swatch button + Add -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <!-- EditFieldTextBox (Controls.xaml): the search-box look - flat
                             SearchFieldBrush, themed focus border, sunken bevel on 98SE. -->
                        <TextBox x:Name="NewNameBox" Width="180" Height="26"
                                 Style="{StaticResource EditFieldTextBox}"
                                 KeyDown="NewNameBox_KeyDown"/>
                        <Border x:Name="NewColorSwatch" Width="26" Height="26"
                                CornerRadius="{DynamicResource SmallCornerRadius}" Margin="8,0,0,0"
                                Cursor="Hand" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                MouseLeftButtonUp="NewColorSwatch_Click" ToolTip="{DynamicResource Str_TT_TagPickColor}"/>
                        <Button x:Name="AddBtn" Content="{DynamicResource Str_Btn_TagAdd}" Click="Add_Click"
                                Style="{StaticResource SurfaceButton}" Margin="8,0,0,0" Padding="12,0" Height="26"/>
                    </StackPanel>
                    <TextBlock x:Name="DlgStatus" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Buttons -->
                <Grid Grid.Row="2" Margin="24,0,24,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DoneBtn" Content="{DynamicResource Str_Btn_Done}" Click="Close_Click"
                                Style="{StaticResource OutlineButton}" Width="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </ContentControl>
</Window>
