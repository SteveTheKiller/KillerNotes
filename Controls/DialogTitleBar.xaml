<!-- THE dialog caption bar, defined ONCE and used by every XAML dialog that is not ConfirmDialog
     (which carries the same markup inline as the reference). Copies of this block in each dialog
     are how the captions drifted apart between apps; change the caption HERE.
     - The app icon, then the wordmark ("Killer" + accent word, or "The " + name) with its soft
       shadow copies, or the plain bold caption on a theme with a Win98-style band. The swap is
       DialogWordmarkVisibility / DialogPlainTitleVisibility, the same keys ConfirmDialog uses.
     - Subtitle (optional) appends "  <sub>" after the wordmark in the muted brush, and
       " - <sub>" to the plain caption. That is how a dialog is titled ("KillerNotes  Databases").
     - The X is the family OverlayCloseButton with AboutCloseGlyph at DialogCloseWidth x
       DialogCloseHeight. Never ChromeCloseButton: that is the main window's caption X, and on a
       card it paints a filled red block.
     - Dragging the bar moves the owning window. The host wires CloseRequested. -->
<UserControl x:Class="KillerNotes.Controls.DialogTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:KillerFamily.Theming"
             xmlns:local="clr-namespace:KillerNotes.Controls"
             Focusable="False" IsTabStop="False">
    <Border Background="{DynamicResource DialogTitleBarBrush}"
            Height="{DynamicResource DialogTitleBarHeight}"
            MouseLeftButtonDown="Bar_MouseLeftButtonDown">
        <Grid Margin="{DynamicResource DialogTitleBarPadding}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <local:AppIcon x:Name="TitleIcon" IsHitTestVisible="False" VerticalAlignment="Center"
                       Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                       Margin="{DynamicResource TitleIconMargin}"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <!-- Negative margins keep the wordmark font's deep descent out of the layout so it
                     is never clipped, and the 5px lift matches the main title bar. -->
                <Grid VerticalAlignment="Center" Margin="0,-18,0,-22" IsHitTestVisible="False">
                    <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                    <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                Visibility="{DynamicResource DialogWordmarkVisibility}"
                                Opacity="{DynamicResource WordmarkShadowOpacity}">
                        <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run x:Name="WordLead0" Text="Killer" Foreground="#D8000000"/><Run x:Name="WordAccent0" FontFamily="{DynamicResource WordmarkAccentFont}" Text="App" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/><Run x:Name="Sub0" FontFamily="{DynamicResource BrandSansFont}" FontSize="18" Foreground="#D8000000"/></TextBlock>
                    </StackPanel>
                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                               Visibility="{DynamicResource DialogWordmarkVisibility}" Margin="1,2,0,0"
                               Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run x:Name="WordLead1" Text="Killer" Foreground="Transparent"/><Run x:Name="WordAccent1" FontFamily="{DynamicResource WordmarkAccentFont}" Text="App" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/><Run x:Name="Sub1" FontFamily="{DynamicResource BrandSansFont}" FontSize="18" Foreground="Transparent"/></TextBlock>
                    <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                               Visibility="{DynamicResource DialogWordmarkVisibility}"><Run x:Name="WordLead2" Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run x:Name="WordAccent2" FontFamily="{DynamicResource WordmarkAccentFont}" Text="App" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/><Run x:Name="Sub2" FontFamily="{DynamicResource BrandSansFont}" FontSize="18" Foreground="{DynamicResource MutedTextBrush}"/></TextBlock>
                </Grid>
                <!-- Outside the wordmark grid so the wordmark's lift and bleed never move it. -->
                <TextBlock x:Name="PlainTitle" Text="KillerNotes" FontFamily="{DynamicResource ChromeFontFamily}" VerticalAlignment="Center"
                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}" IsHitTestVisible="False"
                           Visibility="{DynamicResource DialogPlainTitleVisibility}"/>
            </StackPanel>
            <Button x:Name="CloseButton" Content="{DynamicResource AboutCloseGlyph}" Click="Close_Click"
                    ToolTip="{DynamicResource Str_Sys_Close}"
                    AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="{DynamicResource DialogCloseWidth}" Height="{DynamicResource DialogCloseHeight}"
                    Style="{StaticResource OverlayCloseButton}"/>
        </Grid>
    </Border>
</UserControl>
