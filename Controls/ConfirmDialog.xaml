<!-- KillerUI kit. Themed confirm dialog: same surface, grain, shadow, and wordmark
     language as the main window. Used by About.cs for the self-update prompt; reuse it
     anywhere a MessageBox would break the look (install prompts, destructive confirms). -->
<Window x:Class="KillerNotes.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Dialog cards sit on the dark tier. Inputs and DimTextBrush are calibrated against it;
         on SurfaceBrush a field is the same colour as the card behind it. -->
    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. One copy each, in Controls.xaml and
         DialogTitleBar.xaml - never inline them here again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar Grid.Row="0" CloseRequested="Cancel_Click"/>

                <!-- Body (defaults are placeholders; the configurable ctor overwrites them) -->
                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText" Text="Install KillerNotes to your user profile?"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="20" TextWrapping="Wrap">
                        <Run Text="- Start Menu shortcut"/>
                        <LineBreak/>
                        <Run Text="- Appears in Add/Remove Programs"/>
                    </TextBlock>
                    <!-- Optional checkbox: shown only when the
                         configurable ctor gets a check1Label (e.g. Desktop shortcut). -->
                    <CheckBox x:Name="Check1" Visibility="Collapsed" Margin="0,10,0,0"
                              FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}"
                            Width="80" Margin="0,0,8,0"/>
                    <!-- OutlineButton (family standard, like KillerScan's Scan button):
                         accent outline at rest, fills solid on hover -->
                    <Button x:Name="OkButton" Content="Install" Click="OK_Click"
                            Style="{StaticResource OutlineButton}"
                            Width="80"/>
                </StackPanel>
            </Grid>
    </ContentControl>
</Window>
