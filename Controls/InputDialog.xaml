<!-- KillerUI kit. Themed single-line text prompt: same surface, grain, shadow, and
     wordmark language as ConfirmDialog. Used by Groups.cs for naming/renaming note
     groups (#4); reuse anywhere a one-line input is needed. Enter confirms, Esc cancels. -->
<Window x:Class="KillerNotes.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. One copy each, in Controls.xaml and
         DialogTitleBar.xaml - never inline them here again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar Grid.Row="0" CloseRequested="Cancel_Click"/>

                <!-- Body: heading + the input box -->
                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText" Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <!-- EditFieldTextBox (Controls.xaml): the search-box look - flat
                         SearchFieldBrush, themed focus border, white + sunken on 98SE. This was
                         a transparent box with an accent border, the one input in the app that
                         did not look like an edit field (2026-08-08). -->
                    <TextBox x:Name="ValueBox" FontSize="12" Padding="6,4"
                             Style="{StaticResource EditFieldTextBox}"
                             KeyDown="ValueBox_KeyDown"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}"
                            Width="80" Margin="0,0,8,0"/>
                    <Button x:Name="OkButton" Content="OK" Click="OK_Click"
                            Style="{StaticResource OutlineButton}"
                            Width="80"/>
                </StackPanel>
            </Grid>
    </ContentControl>
</Window>
