<!-- Manage databases: browse, create, rename, delete, and switch between the .db files
     in the KillerNotes data folder. Same dialog chrome as ConfirmDialog. The caller closes
     the note store before showing this, so every file (active included) is safe to touch. -->
<Window x:Class="KillerNotes.Controls.DatabasesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. This dialog is where both patterns were worked
         out (the childless shadow sibling, the caption swap - 2026-08-07); the single
         copies now live in Controls.xaml and DialogTitleBar.xaml - never inline them again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar Grid.Row="0" Subtitle="{DynamicResource Str_Db_Title}"
                                      CloseRequested="Close_Click"/>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24,16,24,12">
                    <!-- The "Databases" heading that used to sit here has moved into the caption,
                         beside the wordmark, so the dialog is titled where every other one is. -->
                    <!-- The list is a CLIENT AREA: square corners from the theme rather than a
                         hardcoded 4, and the crossed sunken bevel so it reads as recessed into the
                         card like every other list and field in the app. The bevels are siblings in
                         the Grid below, never children of the bordered element. -->
                    <Grid>
                    <!-- Elevation shadow on a childless sibling BEHIND the pane (family rule).
                         PaneShadowEffect, NEVER the keyed PaneShadow - see TagsDialog's note
                         (full-strength shadow on 98SE otherwise; the theme-built effect is
                         null there). -->
                    <Border IsHitTestVisible="False" Background="{DynamicResource PaneBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Effect="{DynamicResource PaneShadowEffect}"/>
                    <Border Background="{DynamicResource PaneBrush}"
                            BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ListBox x:Name="DbList" Height="170" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" Margin="4"
                                 MouseDoubleClick="DbList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="DbList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Rename}" Icon="&#xE8AC;" Click="RenameMenu_Click"/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Delete}" Icon="&#xE74D;" Click="Delete_Click"/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_CopyFile}" Icon="&#xE8C8;" Click="CopyFileMenu_Click"
                                              ToolTip="{DynamicResource Str_TT_CopyFile}"/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_ExportKndb}" Icon="&#xE74E;" Click="ExportMenu_Click"
                                              ToolTip="{DynamicResource Str_TT_ExportKndb}"/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Reveal}" Icon="&#xE838;" Click="RevealMenu_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <!-- The theme's radius, not a hardcoded 4. A list
                                                     row on a square-cornered theme is a square
                                                     selection bar - rounding it is a modern
                                                     convention that theme is explicitly not.
                                                     (2026-08-07) -->
                                                <Border x:Name="bg" Background="Transparent"
                                                        CornerRadius="{DynamicResource SmallCornerRadius}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                                        <!-- The row's text has to move with the fill. Setting only the
                                                             background left the default light foreground on top of the
                                                             selection, which is unreadable the moment a theme selects
                                                             with a bright accent: Ectoplasm's RowSelectedBrush is
                                                             #ead900, and white on that is invisible. SelectionFg is
                                                             each theme's answer for exactly this and is defined in all
                                                             thirteen. -->
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                            BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}"
                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    <!-- Pane grain OVER the rows, LAST (the locked menu rule) - the dialog's
                         texture lives here, never in a card-wide overlay. -->
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Opacity="{DynamicResource GrainOpacity}"
                            Background="{DynamicResource GrainTileBrush}"/>
                    </Grid>
                    <TextBlock x:Name="DlgStatus" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Buttons: glyphs left (new / delete / explorer; rename is inline via
                     double-click), Open right -->
                <Grid Grid.Row="2" Margin="24,0,24,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- Padding 0: SurfaceButton's side padding clips glyphs at fixed width -->
                        <Button x:Name="NewBtn" Content="&#xE710;" Click="New_Click" ToolTip="{DynamicResource Str_TT_NewDb}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="DeleteBtn" Content="&#xE711;" Click="Delete_Click" ToolTip="{DynamicResource Str_TT_DeleteDb}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="ExplorerBtn" Content="&#xE838;" Click="Explorer_Click"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" ToolTip="{DynamicResource Str_TT_Explorer}"/>
                        <Button x:Name="DataFolderBtn" Content="&#xE8DE;" Click="DataFolder_Click"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="6,0,0,0" ToolTip="{DynamicResource Str_TT_DataFolder}"/>
                        <!-- Scheduled backups of the selected database (1.3.1, BackupDialog). -->
                        <Button x:Name="BackupsBtn" Content="&#xE74E;" Click="Backups_Click"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="6,0,0,0" ToolTip="{DynamicResource Str_TT_Backups}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- OutlineButton (family standard): accent outline, fills solid on hover -->
                        <Button x:Name="OpenBtn" Content="{DynamicResource Str_Btn_Open}" Click="Open_Click"
                                Style="{StaticResource OutlineButton}" Width="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </ContentControl>
</Window>
