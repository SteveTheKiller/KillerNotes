<!--
    KillerUI kit - Controls.xaml
    Theme-INDEPENDENT control styles. All brush references use DynamicResource, so a
    live theme/accent change repaints them automatically. Merge this AFTER a
    Themes/{Theme}.xaml colour dictionary (see App.xaml in the guide).

-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kui="clr-namespace:KillerNotes.Controls">

    <!-- Shared film-grain tile. ImageSource is assigned once at startup (Chrome.ApplyGrainTexture)
         so global styles - like the context menus - can layer the same grain as the chrome/flyouts. -->
    <ImageBrush x:Key="GrainTileBrush" TileMode="Tile"
                ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>

    <!-- Floors the scrollbar thumb at a grabbable minimum. -->
    <kui:ThumbViewportFloorConverter x:Key="ThumbFloor"/>

    <!-- Typewriter wordmark font (bundled in Fonts/). The face name after '#' must match the
         font's internal family name; keep it as-is if you copy KillerScan's Fonts/ verbatim. -->
    <FontFamily x:Key="WordmarkFont">/KillerNotes;component/Fonts/#Typewriter - a602 (dead postman 2004)</FontFamily>
    <!-- User-swappable slots (Fonts.cs, 1.1.2). The wordmark above never changes - it is
         the logo - but HeaderFont (group titles, Killculator title) and ContentFont (the
         editor default) can be overridden at the Application level by the Fonts dialog;
         these entries are the killer defaults it falls back to. -->
    <FontFamily x:Key="HeaderFont">/KillerNotes;component/Fonts/#Typewriter - a602 (dead postman 2004)</FontFamily>
    <FontFamily x:Key="SidebarFont">Segoe UI</FontFamily>
    <!-- Bahnschrift: stock DIN face on Win10/11, pairs with the typewriter headers;
         Segoe UI fallback for editions without it. The sidebar deliberately stays
         Segoe UI - best small-size hinting for the dense 10-11px rows. -->
    <FontFamily x:Key="ContentFont">Bahnschrift, Segoe UI</FontFamily>

    <!-- Global themed tooltip. Implicit (no key) so every tooltip app-wide picks it up. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.45"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid Row (translucent so a pane grain shows through) -->
    <Style x:Key="DarkDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource RowAltBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataGrid Cell -->
    <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.7"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Primary Button (filled accent) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- No stock dotted focus rectangle - it draws over the caption. See OutlineButton. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Hover/press are a translucent tint OVER the accent, so the feedback works
                         whatever the palette says. All 15 accent files set PrimaryHoverBrush ==
                         PrimaryBrush, so the old brush swap was a no-op and this button had never
                         shown a hover. Ported from KillerShell. (Steve, 2026-07-30.) -->
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <Border x:Name="tint" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent"/>
                            <Border x:Name="bevelLight" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                            <Border x:Name="bevelDark" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="#2EFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="tint" Property="Background" Value="#38000000"/>
                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bevelDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outline Button (accent border + text, reactive fill on hover) -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <!-- Transparent at rest = a true outline (accent border + accent text), per the
             family standard. RowSelectedBrush was a solid accent fill in the Light accents
             (same value as OutlineBtnBrush), so the resting button was a solid block with
             invisible same-color text. -->
        <!-- OutlineFaceBrush / OutlineTextBrush default to Transparent and OutlineBtnBrush, so
             the twelve flat themes get the accent outline exactly as before. A theme whose
             buttons all share one face - a Win98 dialog has two IDENTICAL grey buttons, the
             default one marked by its border, never by a different colour - points both at that
             face instead, and Cancel and OK stop disagreeing. (Steve, 2026-08-07.) -->
        <Setter Property="Background" Value="{DynamicResource OutlineFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OutlineTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OutlineRestBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- WPF's stock focus visual is a dotted rectangle drawn OVER the control, which on a
             themed button reads as a stray line through the caption - that was the "broken"
             Cancel button. The templates show focus through their own hover/press states. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- The bevels are SIBLINGS of the border, not children of it. Nested inside,
                         they were drawn within the 1px border AND the 14,5 padding, so the raised
                         edge appeared around the TEXT rather than around the button. As siblings
                         they fill the whole button and land on its outer edge - exactly where a
                         flat outline sits, so a bevelled theme replaces the outline rather than
                         drawing a second line inside it. -->
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="bevelLight" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border x:Name="bevelDark" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Order matters: IsPressed must come after IsMouseOver to win. -->
                        <!-- Keyed for the same reason as the face: a theme whose OK button is a
                             plain grey one hovers to a lighter grey, not to a solid accent fill.
                             Both default to what they were. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlineHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OutlineHoverTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <!-- Pale accent press tint (the per-theme OutlinePressedBrush, defined
                                 in every theme for exactly this and previously unused). Readable
                                 accent text on it in every theme; RowSelectedBrush here was the
                                 solid accent in Light, hiding the text on press too. -->
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlinePressedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OutlineBtnBrush}"/>
                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bevelDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Surface Button (secondary): fill one tier lighter than what it sits on, a dim border, and a
         hover that dims rather than colours. Accent on hover belongs to OutlineButton and
         PrimaryButton; a secondary button that lights up accent reads as the primary action. -->
    <Style x:Key="SurfaceButton" TargetType="Button">
        <!-- ChipFaceBrush, not PaneBrush. A button is not a client area, and on a theme where
             PaneBrush IS the white client colour every SurfaceButton in the app came out white -
             the picker's Cancel, the dialog buttons, all of them. ThemeManager defaults
             ChipFaceBrush to PaneBrush, so the other twelve themes are unchanged. -->
        <Setter Property="Background" Value="{DynamicResource ChipFaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- ButtonEdgeBrush, not CardBorderBrush: on a bevelled theme the bevel IS the button's
             edge, so this goes transparent there and the flat outline stops doubling up with it.
             ThemeManager defaults it to CardBorderBrush, so only a theme that cares states it. -->
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdgeBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- No stock dotted focus rectangle - it draws over the caption. See OutlineButton. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Bevels are SIBLINGS of the border, matching OutlineButton. Nested inside
                         they were drawn within the 1px edge and the 12,6 padding, so the raised
                         edge appeared around the text instead of around the button. -->
                    <Grid>
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="bevelLight" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border x:Name="bevelDark" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Order matters: IsPressed after IsMouseOver so it wins. -->
                        <!-- A real fill change, not an opacity fade - the fade is invisible on a
                             dark panel and the button reads as dead. (Steve, 2026-07-30.) -->
                        <!-- SurfaceHoverBrush, not RowHoverBrush. On a theme whose LIST hover and
                             whose button face are the same grey - 98SE has both at #d4d0c8 - a
                             button hovering to RowHoverBrush does not change at all, and every
                             Cancel in the app read as dead. Defaults to RowHoverBrush, so the
                             other twelve are unchanged. (Steve, 2026-08-07.) -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource OutlineBtnBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bevelDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scrollbar: thin by default, fattens via the thumb's margin on hover, no arrow buttons.
         ThumbFloor keeps the thumb grabbable on long lists. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="{DynamicResource ScrollBarThickness}"/>
        <Setter Property="MinWidth" Value="{DynamicResource ScrollBarThickness}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <!-- DockPanel, so the two line buttons can bracket the track. They are SQUARE
                         (both dimensions = ScrollArrowSize) which makes one size key work for both
                         orientations, since the bar's cross axis is the same measurement. The key
                         defaults to 0, so on every other theme the buttons occupy no space at all
                         and the bar is the bare track it has always been - no Visibility juggling
                         and no second template to keep in step. -->
                    <DockPanel LastChildFill="True">
                        <!-- The arrow is the button's CONTENT, not a literal inside its template.
                             It was hardcoded there, and a TargetName in the ScrollBar's template
                             cannot reach into a nested one - so the horizontal trigger below could
                             re-dock these buttons and swap their commands but had no way to turn
                             the triangles, and a horizontal bar showed up/down arrows. -->
                        <RepeatButton x:Name="LineUp" DockPanel.Dock="Top" Focusable="False" IsTabStop="False"
                                      Command="ScrollBar.LineUpCommand" Content="0"
                                      Width="{DynamicResource ScrollArrowSize}" Height="{DynamicResource ScrollArrowSize}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Grid>
                                        <Border Background="{DynamicResource CaptionButtonBrush}"/>
                                        <Border x:Name="lu1" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                        <Border x:Name="lu2" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        <!-- A drawn triangle, not a character. The Unicode arrows
                                             rendered at whatever glyph the UI font happens to
                                             carry - different weights, off-centre, and visibly
                                             wrong at 7px. This is a 7x4 path, so it is the same
                                             crisp shape at every size and in every language.
                                             Content is the ROTATION in degrees, which is how one
                                             template serves all four directions - a TargetName in
                                             the ScrollBar template cannot reach in here to swap a
                                             Path's Data. (Steve, 2026-08-07.) -->
                                        <Path x:Name="luGlyph" Data="M 0,4 L 3.5,0 L 7,4 Z"
                                              Width="7" Height="4" Stretch="None"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Fill="{DynamicResource CaptionGlyphBrush}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!-- Pressed reverses the bevel, like every other Win98 button -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="lu1" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                                            <Setter TargetName="lu2" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                        <RepeatButton x:Name="LineDown" DockPanel.Dock="Bottom" Focusable="False" IsTabStop="False"
                                      Command="ScrollBar.LineDownCommand" Content="180"
                                      Width="{DynamicResource ScrollArrowSize}" Height="{DynamicResource ScrollArrowSize}">
                            <RepeatButton.Template>
                                <ControlTemplate TargetType="RepeatButton">
                                    <Grid>
                                        <Border Background="{DynamicResource CaptionButtonBrush}"/>
                                        <Border x:Name="ld1" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                        <Border x:Name="ld2" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        <Path x:Name="ldGlyph" Data="M 0,4 L 3.5,0 L 7,4 Z"
                                              Width="7" Height="4" Stretch="None"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Fill="{DynamicResource CaptionGlyphBrush}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ld1" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                                            <Setter TargetName="ld2" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RepeatButton.Template>
                        </RepeatButton>
                    <Grid>
                        <!-- The track well. Transparent by default, so the bar keeps floating over
                             whatever is behind it exactly as before. A Win98 theme fills it with the
                             dithered channel colour and sinks it with a crossed bevel, because there
                             the scrollbar is a control with a recessed groove, not an overlay. -->
                        <Border Background="{DynamicResource ScrollTrackBrush}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource ScrollTrackBevelDark}"
                                BorderThickness="{DynamicResource BevelLightThickness}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource ScrollTrackBevelLight}"
                                BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                            <Track.ViewportSize>
                                <MultiBinding Converter="{StaticResource ThumbFloor}" ConverterParameter="64">
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ViewportSize"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Orientation"/>
                                </MultiBinding>
                            </Track.ViewportSize>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageBack" Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageForward" Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <!-- Radius and margin are keyed: the family thumb is a
                                                             rounded lozenge floating in the track, the Win98 one
                                                             is a square raised button that FILLS it. The bevel
                                                             pair draws nothing at 0 thickness. -->
                                                        <Grid x:Name="thumbBorder" Margin="{DynamicResource ScrollThumbMargin}">
                                                            <!-- thumbFill is what the hover trigger recolors. When this Grid
                                                                 grew around the old Border for the 98SE bevels, the hover
                                                                 setter kept targeting thumbBorder - now the GRID - and its
                                                                 square background bled out past the rounded fill's corners
                                                                 on every rounded theme (Steve, 2026-08-08). -->
                                                            <Border x:Name="thumbFill" Background="{DynamicResource ScrollThumbBrush}"
                                                                    CornerRadius="{DynamicResource ScrollThumbRadius}"/>
                                                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                                                    BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                                                    BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
                                                                <Setter TargetName="thumbBorder" Property="Margin" Value="0,4"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="thumbFill" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                                <Setter TargetName="thumbBorder" Property="Margin" Value="2,2"/>
                                                                <Setter TargetName="thumbBorder" Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.3"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <!-- The Track is IsDirectionReversed=True for the vertical bar (value 0 = top). A
                             horizontal bar must NOT be reversed, or the thumb sits on the right at offset 0. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="PageBack"    Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            <!-- Re-dock the line buttons to the ends of a horizontal bar and turn the
                                 triangles to match. Commands change too: LineUp/LineDown are the
                                 vertical names, LineLeft/LineRight the horizontal ones. -->
                            <Setter TargetName="LineUp"   Property="DockPanel.Dock" Value="Left"/>
                            <Setter TargetName="LineDown" Property="DockPanel.Dock" Value="Right"/>
                            <Setter TargetName="LineUp"   Property="Command" Value="ScrollBar.LineLeftCommand"/>
                            <Setter TargetName="LineDown" Property="Command" Value="ScrollBar.LineRightCommand"/>
                            <!-- Rotation in degrees: 270 points the triangle left, 90 right. -->
                            <Setter TargetName="LineUp"   Property="Content" Value="270"/>
                            <Setter TargetName="LineDown" Property="Content" Value="90"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <!-- ScrollBarThickness, not a hardcoded 12. The vertical bar reads the key and the
                     horizontal one did not, so on a theme that widens the bar (98SE takes it to
                     16 to fit real arrow buttons) the horizontal bar stayed 12 tall while its
                     square ScrollArrowSize buttons were 16 - and the bar came out visibly clipped
                     along the bottom of the list. Both axes track one key now. -->
                <Setter Property="Height" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="MinHeight" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Context Menu (grain + rounding + shadow match the theme flyout) -->
    <Style TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- True so the popup HWND is transparent: the custom soft shadow below then
             renders on the Margin=6 halo instead of the popup showing as a hard
             rectangle around the rounded menu. The shadow sits on its own item-free
             Border (see template), so this does not reintroduce the submenu black-box. -->
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- FADE IN. A ContextMenu has no PopupAnimation property - it is not a Popup,
                         it is hosted inside one WPF owns - so the fade is driven from the template
                         with an EventTrigger on Loaded. Submenus already faded, so a menu appeared
                         instantly while its own children faded in, which is backwards. 150ms
                         ease-out, the curve Anim.FadeIn uses. (Steve, 2026-07-30.) -->
                    <Grid x:Name="MenuRoot" Opacity="0" Margin="6">
                        <!-- Shadow cast from a dedicated item-free layer. Each MenuItem carries a
                             transparent SubPopup (for the Tags submenu); a WPF Effect over a
                             subtree that contains an AllowsTransparency popup renders the drop
                             shadow as a black box, so the effect must not sit above the items. -->
                        <Border CornerRadius="{DynamicResource PanelCornerRadius}" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                            </Border.Effect>
                        </Border>
                        <!-- CornerRadius follows the theme, it is NOT hardcoded 6. A square-cornered
                             theme got a rounded card with square bevels drawn across it, which is
                             what made the corners look wrong. Same value as the outer shadow border. -->
                        <Border CornerRadius="{DynamicResource PanelCornerRadius}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                        Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                                <StackPanel IsItemsHost="True" Margin="{TemplateBinding Padding}" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Grid>
                        </Border>
                        <!-- Bevels OUTSIDE the card border, as siblings - nested inside they were
                             drawn within its 1px edge, so the flat border and the bevel both showed
                             and disagreed at the corners. -->
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevelLightBrush}"
                                BorderThickness="{DynamicResource MenuBevelLightThickness}"
                                Margin="{DynamicResource MenuBevelInnerMargin}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevelDarkBrush}"
                                BorderThickness="{DynamicResource MenuBevelDarkThickness}"
                                Margin="{DynamicResource MenuBevelInnerMargin}"/>
                        <!-- The OUTER ring of a raised menu edge. Win98 draws a menu with the same
                             EDGE_RAISED double bevel as a window - white over BLACK on the outside,
                             #dfdfdf over #808080 within - and one ring alone reads as a plain line
                             with a highlight rather than as a raised card. Transparent at zero
                             thickness by default. (Steve, 2026-08-07.) -->
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2LightBrush}"
                                BorderThickness="{DynamicResource MenuBevel2LightThickness}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2DarkBrush}"
                                BorderThickness="{DynamicResource MenuBevel2DarkThickness}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ContextMenu.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="MenuRoot" Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- TextBrush, not MenuTextBrush: menu items are body text, not secondary labels.
             Family standard, see KillerUI/README.md surface rules. -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <!-- 8 on the left, not 24: the icon gutter provides the inset now. -->
        <Setter Property="Padding" Value="8,6,10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <!-- FOUR COLUMNS, the family standard, copied from KillerPDF:
                           0  16px gutter - MenuItem.Icon, or the check glyph for checkable items
                           1  the header
                           2  InputGestureText, right-aligned
                           3  submenu chevron
                         KillerNotes previously overlaid the icon and check on the item and hung the
                         gesture and chevron off negative margins in a 2-column grid. Same parts, a
                         different geometry, so the menus never quite lined up with the other apps'.
                         (Standardised 2026-07-30.) -->
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="3" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- TextElement.FontFamily on the PRESENTER, so both idioms work: a bare
                                 glyph string (Icon="&#xE8AC;", which most of KillerNotes uses) picks
                                 the font up by inheritance, and an explicit TextBlock icon still
                                 wins with its own. Without it every bare-string icon in the app
                                 renders as a blank box in the UI font. -->
                            <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon"
                                              TextElement.FontFamily="Segoe MDL2 Assets"
                                              TextElement.FontSize="12"
                                              TextElement.Foreground="{DynamicResource DimTextBrush}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Visibility="Collapsed"/>

                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>

                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="24,0,0,0"/>

                            <TextBlock x:Name="SubArrow" Grid.Column="3" Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="Collapsed"/>

                            <!-- Submenu popup, same chrome + grain as the ContextMenu template.
                                 OverridesDefaultStyle discards WPF's stock submenu Popup, so a
                                 template without this part can never open its children. -->
                            <Popup x:Name="SubPopup" AllowsTransparency="True" Placement="Right"
                                   HorizontalOffset="-4" Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}">
                                <Grid Margin="6">
                                    <Border Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="6"
                                            IsHitTestVisible="False">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4"
                                                              Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource MenuBackgroundBrush}"
                                            BorderBrush="{DynamicResource MenuBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                        <Grid>
                                            <Border IsHitTestVisible="False" CornerRadius="5"
                                                    Background="{DynamicResource GrainTileBrush}"
                                                    Opacity="{DynamicResource GrainOpacity}"/>
                                            <StackPanel IsItemsHost="True" Margin="0,4"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                                    BorderThickness="{DynamicResource BevelLightThickness}"/>
                                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                                    BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Collapse the shortcut column when there is no gesture, so items without
                             one do not reserve its 24px left margin as phantom right padding. -->
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- SELECTION, not a gray wash - solid SelectionBg fill with SelectionFg
                             text, the same treatment a selected tool or tab gets. The gesture and
                             chevron are recoloured too: they are MutedTextBrush at rest, which is
                             unreadable on a saturated fill. Family standard, see KillerUI.
                             (Steve, 2026-07-30.) -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                            <Setter TargetName="SubArrow" Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedSeparator" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Background" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The implicit style, for separators outside a menu. -->
    <Style TargetType="Separator" BasedOn="{StaticResource ThemedSeparator}"/>

    <!-- A Separator INSIDE a MenuItem is styled by this keyed alias, NOT by the implicit
         TargetType style above - WPF looks up MenuItem.SeparatorStyleKey for it. Without
         this, a menu separator falls back to the stock light-grey Aero line however well
         the implicit style is themed. Family gap noted in code/CLAUDE.md; Killendar has
         the same alias. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
           BasedOn="{StaticResource ThemedSeparator}"/>

    <!-- Card Border -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- Theme swatch (title-bar theme/accent picker dots). Background = the swatch colour;
         BorderBrush/Thickness form the active ring (set in ThemeFlyout.cs). -->
    <!-- KillerPDF family-standard rail flyouts. -->
    <Style x:Key="FlyoutCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}"/>
        <Setter Property="Margin" Value="6"/><Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="Black" BlurRadius="7" ShadowDepth="2" Direction="270" Opacity="{DynamicResource BarShadowOpacity}"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlyoutGrain" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}"/>
        <Setter Property="Background" Value="{DynamicResource GrainTileBrush}"/><Setter Property="Opacity" Value="{DynamicResource GrainOpacity}"/>
    </Style>
    <Style x:Key="PanelMenuItem" TargetType="MenuItem">
        <Setter Property="Padding" Value="0"/><Setter Property="StaysOpenOnClick" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentDot" TargetType="Border">
        <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="CornerRadius" Value="{DynamicResource AccentSwatchCornerRadius}"/>
        <Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="2"/><Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="ThemeRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="3" Margin="-8,0,2,0" Padding="10,4">
                <DockPanel LastChildFill="True"><Grid Width="16" Height="16" Margin="0,0,8,0" DockPanel.Dock="Left">
                    <!-- The WELL behind the ring. A Win98 radio is a white sunken circle with the
                         dot inside it, not a hollow ring on the panel face - small, but it is the
                         difference between reading as a control and reading as an outline.
                         Transparent by default, so the other twelve are untouched. -->
                    <Ellipse x:Name="well" Width="14" Height="14" Fill="{DynamicResource RadioWellBrush}"/>
                    <Ellipse x:Name="ring" Width="14" Height="14" Stroke="{DynamicResource DimTextBrush}" StrokeThickness="1.5"/>
                    <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                </Grid><ContentPresenter VerticalAlignment="Center"/></DockPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="dot" Property="Visibility" Value="Visible"/><Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/><Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="ThemeSwatch" TargetType="Button">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Ellipse x:Name="dot" Fill="{TemplateBinding Background}"
                             Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dot" Property="StrokeThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="dot" Property="StrokeThickness" Value="3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption buttons (Segoe MDL2 glyphs, hover fill, red close). -->
    <SolidColorBrush x:Key="DangerRed" Color="#e04444"/>

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}"/>
        <Setter Property="Height" Value="{DynamicResource CaptionButtonHeight}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <!-- Bold on a bevelled theme: a hairline MDL2 stroke vanishes on a grey button face -->
        <Setter Property="FontWeight" Value="{DynamicResource CaptionGlyphWeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Bd carries the SAME margin as Face. Without it the hover fill paints the
                             full button cell, spilling into the 1px gaps between the buttons and
                             over the caption behind them - which is what made the hover state look
                             like a loose grey block instead of the button lighting up. -->
                        <Border x:Name="Bd" Margin="{DynamicResource CaptionButtonMargin}"
                                Background="{TemplateBinding Background}"/>
                        <!-- Win98 caption button: its own solid face with a raised bevel, inset from
                             the caption, so the title bar gradient STOPS at the button instead of
                             running under it. CaptionButtonBrush is Transparent and
                             CaptionButtonMargin is 0 on every other theme, so this draws nothing
                             and the modern hover/press fill above is all you see.
                             The glyph lives INSIDE the face so it centres on the button, not on the
                             cell - offsetting the face by a pixel used to leave the glyph off-centre. -->
                        <Border x:Name="Face" Margin="{DynamicResource CaptionButtonMargin}"
                                Background="{DynamicResource CaptionButtonBrush}">
                            <Grid>
                                <Border x:Name="capLight" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border x:Name="capDark" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            <!-- Pressed reverses the bevel, the same swap the other button styles use -->
                            <Setter TargetName="capLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="capDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Canonical floating annotation/format bar controls. Keep these in sync with
         KillerPDF's annotation bars; apps supply only command content. -->
    <Style x:Key="AnnotationBarButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="FontSize" Value="13"/>
        <!-- Its own template, NOT ChromeButton's. ChromeButton draws a raised bevelled face at
             rest, which is right for a caption button and wrong for a toolbar: it made every
             ribbon button look permanently raised. Here the button is FLAT at rest and only
             takes a bevel while pressed, and that bevel is the SUNKEN one - dark on the
             top/left, light on the bottom/right - so it reads as pushed in. Zero thickness at
             rest, so nothing draws on any theme until the press. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"/>
                        <Border x:Name="bTopLeft" IsHitTestVisible="False" BorderThickness="0"/>
                        <Border x:Name="bBotRight" IsHitTestVisible="False" BorderThickness="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            <Setter TargetName="bTopLeft" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="bTopLeft" Property="BorderThickness" Value="{DynamicResource BevelLightThickness}"/>
                            <Setter TargetName="bBotRight" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                            <Setter TargetName="bBotRight" Property="BorderThickness" Value="{DynamicResource BevelDarkThickness}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Toolbar separator. A single flat 1px rule by default; on a bevelled theme it becomes the
         era's ETCHED divider - a grey line with a white one beside it, which is what every Win98
         toolbar and taskbar draws between bands. BarSepLightBrush is transparent by default, so
         the second rule has no width to give away and the twelve flat themes are unchanged.
         (Steve, 2026-08-07.) -->
    <Style x:Key="AnnotationBarSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="{DynamicResource BarSepWidth}"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="Fill" Value="{DynamicResource BarSepBrush}"/>
    </Style>

    <!-- Slider. IMPLICIT, so every Slider in the app picks it up. There was no Slider style at
         all, so the font-size slider fell through to WPF's default template and painted system
         colours on a themed card - the same fall-through the radio buttons had. Sunken track,
         raised thumb, both from the theme's own brushes and bevels. -->
    <Style TargetType="Slider">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <!-- Track: a THIN recessed groove (4px), crossed bevel like every other sunken
                             surface. The thumb is taller than the groove and stands proud of it, which
                             is the Win98 trackbar shape. -->
                        <Grid Height="4" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SliderTrack}"
                                    CornerRadius="{DynamicResource SmallCornerRadius}"/>
                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                    BorderThickness="{DynamicResource BevelLightThickness}"/>
                            <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                    BorderThickness="{DynamicResource BevelDarkThickness}"/>
                        </Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="11" Height="21" Focusable="False" IsTabStop="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource SmallCornerRadius}"/>
                                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close caption button, KillerPDF-style: red glyph at rest, red fill + white glyph on hover -->
    <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
        <Setter Property="Foreground" Value="{DynamicResource CaptionCloseBrush}"/>
        <!-- Win98 pushed close a couple of pixels clear of minimise/maximise. 0 elsewhere. -->
        <Setter Property="Margin" Value="{DynamicResource CaptionCloseGap}"/>
        <!-- The hover block's radius rides Tag so ONE template serves both shapes: this style
             is the main title bar's X, whose block fills the window corner and rounds only with
             it; DialogCloseButton below overrides Tag for the X's that float inset (About,
             Fonts, every dialog caption), whose block rounds all four corners. -->
        <Setter Property="Tag" Value="{DynamicResource CaptionCloseCornerRadius}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- ROUNDED from the theme, via the style's Tag (see the Tag setter above):
                             corner-following for the main X, all-round for the floating ones. The
                             dialogs that used to build their own close button had a rounded hover
                             block; collapsing them onto this shared one lost that and the hover
                             came back as a hard pink square on every rounded theme. The radius keys
                             are 0 on a square theme, so 98SE is unaffected. (Steve, 2026-08-07/08.) -->
                        <Border x:Name="Bd" Margin="{DynamicResource CaptionButtonMargin}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{TemplateBinding Background}"/>
                        <!-- Same Win98 face + raised bevel as ChromeButton; nothing on other themes -->
                        <Border x:Name="Face" Margin="{DynamicResource CaptionButtonMargin}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{DynamicResource CaptionButtonBrush}">
                            <Grid>
                                <Border x:Name="capLight" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border x:Name="capDark" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                <!-- THE close glyph, drawn HERE and nowhere else. Every window used
                                     to carry its own copy of this pair - title bar, About card,
                                     Databases, both pickers, DialogChrome - which is precisely how
                                     they drifted into several different X's. Callers now supply NO
                                     content: Style="{StaticResource ChromeCloseButton}" is the whole
                                     declaration, and there is one place to change it. -->
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="{DynamicResource CaptionGlyphWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Visibility="{DynamicResource CaptionFontGlyphVisibility}"/>
                                <Grid Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{DynamicResource CaptionDrawnGlyphVisibility}">
                                    <Rectangle Width="10" Height="2" Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle.RenderTransform><RotateTransform Angle="45" CenterX="5" CenterY="1"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="10" Height="2" Fill="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle.RenderTransform><RotateTransform Angle="-45" CenterX="5" CenterY="1"/></Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- CaptionHoverBrush is the red fill on the modern themes and the plain
                             button face on a bevelled one, where a red wash would be wrong. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CaptionCloseHoverFgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="capLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                            <Setter TargetName="capDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The FLOATING close: same shared template, all four hover-block corners rounded
         (DialogCloseCornerRadius = SmallCornerRadius, 0 on a square theme). ONLY for the X's
         that float INSET from a window corner - the About and Fonts overlays - where the
         corner-following radius reads as a red square with three hard corners. A dialog
         caption's X sits AT the card corner and stays on ChromeCloseButton, whose block
         rounds with the card's top-right ("top right should be rounded here", Steve,
         2026-08-08). -->
    <Style x:Key="DialogCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeCloseButton}">
        <Setter Property="Tag" Value="{DynamicResource DialogCloseCornerRadius}"/>
    </Style>

    <!-- THE dialog card chrome, defined ONCE. Every XAML dialog (Confirm, Password, Tags,
         Input, Databases) wraps its content in a ContentControl with this style instead of
         carrying its own copy of the shadow/border/bevel/grain stack - five inline copies of
         this block is exactly how the dialogs drifted apart before.
         - The shadow is on its OWN childless sibling, never on the border that holds the
           content: a DropShadowEffect is a bitmap effect, everything inside it is rasterised,
           and the text loses ClearType (CLAUDE.md locks this for the About card; Steve caught
           it live on the Databases caption, 2026-08-07).
         - Halo/radius/edge come from the theme, so a Win98-style theme collapses to a flat,
           square window wearing the stacked 3D bevel pairs; the other twelve themes see the
           usual rounded card with a halo, and the bevels are transparent/0.
         - Focusable/IsTabStop false so the wrapper never steals focus from dialog inputs. -->
    <Style x:Key="DialogCard" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- The family PANE shadow numbers (16/5/270, PaneShadowOpacity), not the
                             softer flyout ones: "this window should have the same... drop shadow
                             as the main window" (Steve, 2026-08-08). -->
                        <!-- PaneShadowEffect (ThemeManager): the family numbers at the theme's
                             opacity, NULL on a flat theme - never an invisible effect, and never
                             a dynamic opacity inside a Freezable (see the ThemeManager note). -->
                        <Border Background="{DynamicResource BackgroundBrush}"
                                CornerRadius="{DynamicResource PanelCornerRadius}"
                                Margin="{DynamicResource DialogHaloMargin}"
                                IsHitTestVisible="False"
                                Effect="{DynamicResource PaneShadowEffect}"/>
                        <Border Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource WindowEdgeBrush}"
                                BorderThickness="{DynamicResource WindowEdgeThickness}"
                                CornerRadius="{DynamicResource PanelCornerRadius}"
                                Margin="{DynamicResource DialogHaloMargin}">
                            <Grid>
                                <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource FrameOuterDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                <!-- Grain UNDER the content - the composition the main window
                                     actually uses: the chrome grain sits beneath its widgets, so
                                     the SEARCH BOX is crisp, and each PANE carries its own grain
                                     overlay above its rows (the menu rule). A card-wide overlay
                                     was tried and put texture over the dialogs' edit fields,
                                     which no input in the app has ("the text input box still
                                     has a gradient and texture here, unlike the main searchbox",
                                     Steve, 2026-08-08); the pane-level overlays live in the
                                     dialogs' own list Grids. -->
                                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                        Opacity="{DynamicResource GrainOpacity}"
                                        Background="{DynamicResource GrainTileBrush}"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- THE dialog edit field, defined ONCE - a single template serving both the TextBox and
         PasswordBox styles below. Matches the main window's search box exactly:
         - SearchFieldBrush fill, never BackgroundBrush: several palettes define BackgroundBrush
           as a GRADIENT, and a field synthesized from it painted the window's gradient into
           itself ("non-gradient", Steve, 2026-08-08).
         - Templated border with themed hover/focus: an unstyled box falls back to WPF's stock
           template, whose focus border is the hardcoded system blue on every theme.
         - Crossed sunken bevel siblings so a bevelled theme reads the field as recessed
           (white + sunken on 98SE); the bevel thicknesses are 0 on the other twelve. -->
    <ControlTemplate x:Key="EditFieldTemplate" TargetType="Control">
        <Border x:Name="bd" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <Grid>
                <Border Panel.ZIndex="2" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                        BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                <Border Panel.ZIndex="2" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource PaneBevelLightBrush}"
                        BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!-- Hover first, focus second so a focused box keeps the accent border (same
                 ordering as the search box). -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="EditFieldTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SearchFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}"/>
        <Setter Property="SelectionOpacity" Value="{DynamicResource TextSelectionOpacity}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextSelectionTextBrush}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EditFieldTemplate}"/>
    </Style>
    <Style x:Key="EditFieldPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SearchFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}"/>
        <Setter Property="SelectionOpacity" Value="{DynamicResource TextSelectionOpacity}"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource EditFieldTemplate}"/>
    </Style>

    <!-- Sidebar icon-rail button (KillerPDF pattern): bare glyph with a soft shadow,
         glyph turns the accent color on hover. Set Content to the glyph; override
         FontFamily/FontSize for text glyphs like the "?" help button. -->
    <Style x:Key="RailButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- 20 logical hugs the 16px glyphs; the RailW=24 column (Sidebar.cs) leaves only
             a 2px inset per side, so zooming scales icons, not blank strip -->
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="{DynamicResource IconShadowOpacity}"/>
                            </TextBlock.Effect>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Style.Triggers>
                                        <!-- Family pattern (KillerShell/Killendar): Tag="on" lights a
                                             toggle whose feature is active, in the accent. -->
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="on">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Elevation shadow: lifts panels/cards slightly off the surface. -->
    <DropShadowEffect x:Key="ShadowBar" Color="Black" BlurRadius="6" ShadowDepth="3" Direction="270" Opacity="{DynamicResource BarShadowOpacity}"/>
    <!-- The content pane's downward shadow is ThemeManager's PaneShadowEffect now (frozen,
         per-palette, null on flat themes). The keyed PaneShadow that lived here - a SHARED
         Freezable with a DynamicResource opacity - is gone: one borrowed use from a dialog
         that later closed took the expression's only inheritance context with it, and the
         main window's footer shadow died (2026-08-08). Do not reintroduce the pattern. -->


    <!-- Themed checkbox: small square, accent check, mono label. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="15" Height="15" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed radio: round ring, accent dot. The checkbox's sibling, with three deliberate
         differences.

         NO Consolas. CheckBox forces a mono label because its labels are short switch names; a
         radio labels a CHOICE, which is usually a phrase, and mono prose reads badly.

         The bullet is TOP-aligned, not centred. A radio option often carries a description under
         its name, and a vertically centred bullet against two lines of text floats between them
         pointing at nothing.

         Content colour is left alone. CheckBox mutes its label until checked, which suits a
         switch; an unselected choice still has to be readable enough to choose. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!-- RadioWellBrush, layered over the ring's own fill. A Win98 radio is a
                             WHITE well with the dot in it, not a dot on the panel colour - the
                             keyed ThemeRadio already had this and the implicit style did not, so
                             every radio outside the theme flyout (the speech-model dialog's, most
                             visibly) came up with a grey well. Transparent by default, so the
                             twelve flat themes keep the plain ring. (Steve, 2026-08-07.) -->
                        <Border x:Name="ring" Width="15" Height="15" CornerRadius="8"
                                VerticalAlignment="Top" Margin="0,2,0,0"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="well" Fill="{DynamicResource RadioWellBrush}" Margin="0"/>
                                <Border x:Name="dot" Width="7" Height="7" CornerRadius="4"
                                        Background="{DynamicResource PrimaryBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Top"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed ComboBox (ported from KillerPDF's DarkComboBox, first user: the Fonts
         dialog). Keyed, not implicit - nothing else in the app is a ComboBox yet. -->
    <Style x:Key="KnComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KnComboItem" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KnCombo" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource KnComboItem}"/>
        <!-- Virtualized dropdown (the Fonts dialog lists ~300 families, each item rendered
             in its own face): the panel comes from ItemsPanel + ItemsPresenter, the proven
             KillerPDF arrangement, so the wheel scrolls the popup wherever the mouse hovers. -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="8" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                              Style="{StaticResource KnComboToggle}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Fade" Placement="Bottom">
                            <Border Background="{DynamicResource MenuBackgroundBrush}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,2,6,6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True" Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
