<!-- Themed password prompt: same surface, grain, and shadow language as ConfirmDialog.
     One box to unlock; a second confirm box appears for set/change (showConfirm ctor arg). -->
<Window x:Class="KillerNotes.Controls.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        MinWidth="360" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. One copy each, in Controls.xaml and
         DialogTitleBar.xaml - never inline them here again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar x:Name="TitleBar" Grid.Row="0" CloseRequested="Cancel_Click"/>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText" Text="Unlock KillerNotes"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <!-- EditFieldPasswordBox (Controls.xaml): the search-box look - flat
                         SearchFieldBrush, themed focus border, sunken bevel on 98SE. -->
                    <PasswordBox x:Name="PwBox" FontSize="13" Padding="6,4" AutomationProperties.Name="{DynamicResource Str_TT_Lock}"
                                 Style="{StaticResource EditFieldPasswordBox}"
                                 KeyDown="PwBox_KeyDown"/>
                    <TextBlock x:Name="ConfirmLabel" Text="{DynamicResource Str_Lbl_Confirm}"
                               Foreground="{DynamicResource DimTextBrush}" FontSize="10"
                               Margin="0,8,0,2" Visibility="Collapsed"/>
                    <PasswordBox x:Name="PwConfirmBox" FontSize="13" Padding="6,4" AutomationProperties.Name="{DynamicResource Str_Lbl_Confirm}"
                                 Style="{StaticResource EditFieldPasswordBox}"
                                 KeyDown="PwBox_KeyDown"
                                 Visibility="Collapsed"/>
                </StackPanel>

                <!-- Buttons: two optional escape hatches on the left (Ext + Ext2, e.g. "New
                     database..." and "Open"), then a flex spacer, then Cancel + confirm on
                     the right. A single StackPanel would let the left and right groups
                     overlap when their combined width exceeds the dialog. A three-column
                     Grid with the middle column as * keeps the two clusters apart under
                     every scale factor. -->
                <Grid Grid.Row="2" Margin="24,0,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="ExtraButton" Click="Extra_Click" Visibility="Collapsed"
                                Style="{StaticResource SurfaceButton}"
                                MinWidth="80" Padding="16,4" Margin="0,0,8,0"/>
                        <Button x:Name="Extra2Button" Click="Extra2_Click" Visibility="Collapsed"
                                Style="{StaticResource SurfaceButton}"
                                MinWidth="80" Padding="16,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                                Style="{StaticResource SurfaceButton}"
                                MinWidth="80" Padding="16,4" Margin="0,0,8,0"/>
                        <!-- OutlineButton (family standard): accent outline, fills solid on hover -->
                        <Button x:Name="OkButton" Content="Unlock" Click="OK_Click"
                                Style="{StaticResource OutlineButton}"
                                MinWidth="80" Padding="16,4"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </ContentControl>
</Window>
