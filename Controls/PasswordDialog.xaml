<!-- Themed password prompt: same surface, grain, and shadow language as ConfirmDialog.
     One box to unlock; a second confirm box appears for set/change (showConfirm ctor arg). -->
<Window x:Class="KillerNotes.Controls.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. One copy each, in Controls.xaml and
         DialogTitleBar.xaml - never inline them here again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar Grid.Row="0" CloseRequested="Cancel_Click"/>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText" Text="Unlock KillerNotes"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <!-- EditFieldPasswordBox (Controls.xaml): the search-box look - flat
                         SearchFieldBrush, themed focus border, sunken bevel on 98SE. -->
                    <PasswordBox x:Name="PwBox" FontSize="13" Padding="6,4"
                                 Style="{StaticResource EditFieldPasswordBox}"
                                 KeyDown="PwBox_KeyDown"/>
                    <TextBlock x:Name="ConfirmLabel" Text="{DynamicResource Str_Lbl_Confirm}"
                               Foreground="{DynamicResource DimTextBrush}" FontSize="10"
                               Margin="0,8,0,2" Visibility="Collapsed"/>
                    <PasswordBox x:Name="PwConfirmBox" FontSize="13" Padding="6,4"
                                 Style="{StaticResource EditFieldPasswordBox}"
                                 KeyDown="PwBox_KeyDown"
                                 Visibility="Collapsed"/>
                </StackPanel>

                <!-- Buttons. ExtraButton (left) is the unlock prompt's escape hatch: shown only
                     when the caller passes extraText (e.g. "New database..."). -->
                <Grid Grid.Row="2" Margin="24,0,24,20">
                    <Button x:Name="ExtraButton" Click="Extra_Click" Visibility="Collapsed"
                            Style="{StaticResource SurfaceButton}" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                                Style="{StaticResource SurfaceButton}"
                                Width="80" Margin="0,0,8,0"/>
                        <!-- OutlineButton (family standard): accent outline, fills solid on hover -->
                        <Button x:Name="OkButton" Content="Unlock" Click="OK_Click"
                                Style="{StaticResource OutlineButton}"
                                Width="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </ContentControl>
</Window>
