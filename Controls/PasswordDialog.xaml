<!-- Themed password prompt: same surface, grain, and shadow language as ConfirmDialog.
     One box to unlock; a second confirm box appears for set/change (showConfirm ctor arg). -->
<Window x:Class="KillerNotes.Controls.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KillerNotes.Controls"
        Title="KillerNotes"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        MinWidth="360" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Card chrome (shadow/border/bevels/grain) is the SHARED DialogCard style; the caption
         is the SHARED DialogTitleBar control. One copy each, in Controls.xaml and
         DialogTitleBar.xaml - never inline them here again. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:DialogTitleBar x:Name="TitleBar" Grid.Row="0" CloseRequested="Cancel_Click"/>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <!-- Unlock layout only (1.7.0, UseUnlockLayout): a lock badge, the database's
                         file name as the title and a quiet line under it. HeadingText and
                         DetailText carry every other prompt (set, change, backup test, sharing). -->
                    <DockPanel x:Name="UnlockHeader" Visibility="Collapsed" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0"
                                Background="{DynamicResource ChipFaceBrush}">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UnlockTitle" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                            <TextBlock x:Name="UnlockSubtitle" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="HeadingText" Text="Unlock KillerNotes"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <!-- EditFieldPasswordBox (Controls.xaml): the search-box look - flat
                         SearchFieldBrush, themed focus border, sunken bevel on 98SE. The eye swaps
                         in a plain text copy while held on (Reveal_Click); the right padding keeps
                         typing clear of it. -->
                    <Grid>
                        <PasswordBox x:Name="PwBox" FontSize="13" AutomationProperties.Name="{DynamicResource Str_TT_Lock}"
                                     Style="{StaticResource EditFieldPasswordBox}" Padding="6,0,30,0"
                                     KeyDown="PwBox_KeyDown" PasswordChanged="PwBox_PasswordChanged"/>
                        <TextBox x:Name="PwPlain" FontSize="13" AutomationProperties.Name="{DynamicResource Str_TT_Lock}"
                                 Style="{StaticResource EditFieldTextBox}" Padding="6,0,30,0" Visibility="Collapsed"
                                 KeyDown="PwBox_KeyDown" TextChanged="PwPlain_TextChanged"/>
                        <Button x:Name="RevealButton" Style="{StaticResource ToolbarButton}" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                Click="Reveal_Click"
                                ToolTip="{DynamicResource Str_Pw_Show}" AutomationProperties.Name="{DynamicResource Str_Pw_Show}">
                            <TextBlock x:Name="RevealGlyph" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource DimTextBrush}"/>
                        </Button>
                    </Grid>
                    <!-- Status lines under the box: a failed unlock, and Caps Lock while it is on. -->
                    <StackPanel x:Name="ErrorLine" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource DangerRed}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource DangerRed}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="CapsLine" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource WarnBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{DynamicResource Str_Pw_CapsLock}" FontSize="12" Foreground="{DynamicResource WarnBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="ConfirmLabel" Text="{DynamicResource Str_Lbl_Confirm}"
                               Foreground="{DynamicResource DimTextBrush}" FontSize="10"
                               Margin="0,8,0,2" Visibility="Collapsed"/>
                    <PasswordBox x:Name="PwConfirmBox" FontSize="13" AutomationProperties.Name="{DynamicResource Str_Lbl_Confirm}"
                                 Style="{StaticResource EditFieldPasswordBox}"
                                 KeyDown="PwBox_KeyDown"
                                 Visibility="Collapsed"/>
                </StackPanel>

                <!-- Buttons: two optional escape hatches on the left (Ext + Ext2, e.g. "New
                     database..." and "Open"), then a flex spacer, then Cancel + confirm on
                     the right. A single StackPanel would let the left and right groups
                     overlap when their combined width exceeds the dialog. A three-column
                     Grid with the middle column as * keeps the two clusters apart under
                     every scale factor. -->
                <Grid Grid.Row="2" Margin="24,0,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="ExtraButton" Click="Extra_Click" Visibility="Collapsed"
                                Style="{StaticResource SurfaceButton}"
                                MinWidth="80" Padding="16,4" Margin="0,0,8,0"/>
                        <Button x:Name="Extra2Button" Click="Extra2_Click" Visibility="Collapsed"
                                Style="{StaticResource SurfaceButton}"
                                MinWidth="80" Padding="16,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                                Style="{StaticResource SurfaceButton}"
                                MinWidth="80" Padding="16,4" Margin="0,0,8,0"/>
                        <!-- OutlineButton (family standard): accent outline, fills solid on hover -->
                        <Button x:Name="OkButton" Content="Unlock" Click="OK_Click"
                                Style="{StaticResource OutlineButton}"
                                MinWidth="80" Padding="16,4"/>
                    </StackPanel>
                </Grid>

                <!-- Unlock layout footer (1.7.0): Unlock moves here as the one filled button, and
                     New and Open fold into "Use another database" (Ctrl+N / Ctrl+O still work). -->
                <StackPanel x:Name="UnlockFooter" Grid.Row="2" Margin="24,0,24,18" Visibility="Collapsed">
                    <Button x:Name="OtherDbButton" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Center"
                            Margin="0,10,0,0" Padding="8,3" Click="OtherDb_Click" ContextMenuOpening="OtherDb_ContextMenuOpening">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str_Pw_OtherDb}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="6,1,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        <!-- Filled with its New and Open tiles as it opens (FillOtherDbCard). -->
                        <Button.ContextMenu>
                            <ContextMenu x:Name="OtherDbMenu"/>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
    </ContentControl>
</Window>
