<Window x:Class="KillerNotes.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:KillerNotes.Models"
        Title="KillerNotes"
        Icon="pack://application:,,,/Resources/kn-icon.ico"
        WindowStyle="None" Background="{DynamicResource BackgroundBrush}"
        MinWidth="720" MinHeight="480" Width="1080" Height="700"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="8" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FmtButton" TargetType="Button" BasedOn="{StaticResource AnnotationBarButton}"/>
        <Style x:Key="FmtSeparator" TargetType="Rectangle" BasedOn="{StaticResource AnnotationBarSeparator}"/>
        <!-- LIST / KEYBOARD caption toggle in the shortcuts overlay header; the active
             one's Foreground is driven from code (KeyboardMap.cs ApplyShortcutView) -->
        <Style x:Key="KsTabBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Right-click any of the three sidebar sort buttons to pick a sort by name;
             the button strip alone is terse. x:Shared="False" gives each button its
             own instance. The active sort is accent-colored and shows its direction
             arrow, refreshed each time the menu opens (Notes.cs SortMenu_Opened /
             SortMenuItem_Click). Picking a sort mirrors clicking its button. -->
        <ContextMenu x:Key="SortMenu" x:Shared="False" Opened="SortMenu_Opened">
            <ContextMenu.Resources>
                <!-- A menu applies MenuItem.SeparatorStyleKey to a Separator, not the app's
                     implicit Separator style, so the divider otherwise falls back to WPF's
                     bright default line. MenuBorderBrush sits too close to the menu fill to
                     read; DimTextBrush (the same dim tone as the menu glyphs) shows a clean,
                     unobtrusive line across every theme. -->
                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Height" Value="1"/>
                    <Setter Property="Margin" Value="8,4"/>
                    <Setter Property="Background" Value="{DynamicResource DimTextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Tag="created" Icon="&#xE823;" Header="{DynamicResource Str_TT_SortTimeOff}" Click="SortMenuItem_Click"/>
            <MenuItem Tag="title" Icon="&#xE8CB;" Header="{DynamicResource Str_TT_SortAlphaOff}" Click="SortMenuItem_Click"/>
            <MenuItem Tag="custom" Icon="&#xE76F;" Header="{DynamicResource Str_TT_SortCustom}" Click="SortMenuItem_Click"/>
            <!-- Reverse the active sort's direction. Hidden for custom order, which has
                 no direction (SortMenu_Opened collapses this and the separator). -->
            <Separator/>
            <MenuItem Tag="reverse" Icon="&#xE895;" Header="{DynamicResource Str_Ctx_ReverseOrder}" Click="SortMenuItem_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Family window frame: KillerPDF draws this WPF edge in addition to the matching DWM
         border. Without it, the client/background transition makes KillerNotes look darker. -->
    <!-- WindowEdgeBrush, not AppBorderBrush. This 1px line rings the whole window, so on a beveled
         theme it lands OUTSIDE the bevel: fine against the light top/left edge, but on the bottom
         and right it puts a bright line immediately outside the dark bevel, which reads as a hard
         stripe. Themes that do not want it set WindowEdgeBrush transparent; the border stays 1px
         either way, so the geometry and the resize grab area never move.
         Defaults to AppBorderBrush in ThemeManager, so only a theme that cares states it. -->
    <Border x:Name="RootBorder" BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="{DynamicResource WindowEdgeThickness}"
            CornerRadius="{DynamicResource WindowCornerRadius}" SnapsToDevicePixels="True">
    <!-- FrameHost holds the window frame OUTSIDE the content. The frame borders used to live
         inside RootGrid as RowSpan=3 overlays, painting on top of the title bar, the sidebar and
         the footer - which was survivable while they all stacked at pixel 0 and only 2px actually
         covered anything. Once they were inset into a real 5px edge they ate 5px off three sides
         and clipped every caption button. Now RootGrid is inset by WindowFramePadding and the
         frame draws in the gap, so nothing is ever painted over. (2026-08-07) -->
    <Grid x:Name="FrameHost">
    <!-- ABOVE the frame rings below (they sit at 8999-9003 in FrameHost). Panel.ZIndex only orders
         SIBLINGS, so with RootGrid declared first the frame painted over everything inside it -
         including the full-window overlays, which is why the About card dimmed the app but left a
         bright 5px ring around it. The two do not overlap in normal use (RootGrid is inset by
         exactly the frame's width), so raising it costs nothing and lets an overlay that bleeds out
         over the frame actually dim it. (2026-08-07) -->
    <Grid x:Name="RootGrid" Opacity="0" Panel.ZIndex="9500" Margin="{DynamicResource WindowFramePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar - sized by the bar's own Height, see below -->
            <RowDefinition Height="*"/>    <!-- sidebar + editor -->
            <RowDefinition Height="24"/>   <!-- footer (family standard) -->
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <!-- Height here, NOT on the RowDefinition: RowDefinition.Height is a GridLength and
             TitleBarHeight is a Double, so binding it there throws an InvalidCastException at
             load and the window never constructs. The row is Auto and this drives it. -->
        <!-- TitleBarBleed lets the caption band run PAST the content inset on the left and right,
             so the gradient reaches the window frame instead of stopping short of it with a strip
             of window face either side. A negative margin, so it is 0 by default and the band is
             exactly as wide as the content on every other theme. (2026-08-07) -->
        <Grid Grid.Row="0" Height="{DynamicResource TitleBarHeight}" Background="{DynamicResource TitleBarBrush}"
              Margin="{DynamicResource TitleBarBleed}">
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}">
                <Border.Background>
                    <ImageBrush x:Name="TitleGrainBrush" TileMode="Tile" ViewportUnits="Absolute"
                                Viewport="0,0,256,256" Stretch="None"/>
                </Border.Background>
            </Border>

            <!-- App icon + wordmark ("Killer" in text color, "Notes" bold in the accent,
                 soft dark shadow copy) - same layout as the KillerScan title bar -->
            <StackPanel x:Name="LogoBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource TitleBarPadding}"
                        HorizontalAlignment="Left" Background="Transparent"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        PreviewMouseWheel="AppSizeBtn_MouseWheel"
                        MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                        ToolTip="{DynamicResource Str_TT_AppSize}">
                <Image Source="pack://application:,,,/Resources/kn-icon.png"
                       Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                       VerticalAlignment="Center" Margin="{DynamicResource TitleIconMargin}"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- Plain caption text, Win98 style: icon then the window name in bold. Collapsed on
                     every theme that does not set UseDialogCaption, where the wordmark shows instead. -->
                <!-- TitleTextMargin lifts the caption a pixel. Its font's cap height does not sit
                     centered in its line box, so a vertically centered TextBlock renders visibly low
                     in a short band; nudging the block is the only way to center what you SEE
                     rather than what WPF measures. 0 by default. (2026-08-07) -->
                <TextBlock Text="KillerNotes" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"
                           Margin="{DynamicResource TitleTextMargin}"
                           FontFamily="{DynamicResource ChromeFontFamily}"
                           Foreground="{DynamicResource ChromeTextBrush}"
                           Visibility="{DynamicResource PlainTitleVisibility}"/>
                <Grid VerticalAlignment="Center" Background="Transparent"
                      Visibility="{DynamicResource WordmarkVisibility}">
                    <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                Opacity="{DynamicResource IconShadowOpacity}">
                        <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run Text="Notes" FontSize="{DynamicResource TitleWordmarkBoldSize}" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                    </StackPanel>
                    <!-- Hard 1px offset copy, NO blur: a stroke-like emboss that gives the wordmark
                         a little depth on a flat theme, which switches the blurred shadow above off
                         via IconShadowOpacity. WordmarkEmbossOpacity is 0 on every other theme, so
                         they keep the soft shadow alone and nothing doubles up. -->
                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                               Margin="1,1,0,0" IsHitTestVisible="False"
                               Opacity="{DynamicResource WordmarkEmbossOpacity}"><Run Text="Killer" Foreground="#70000000"/><Run Text="Notes" FontSize="{DynamicResource TitleWordmarkBoldSize}" FontWeight="Bold" Foreground="#70000000"/></TextBlock>
                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="{DynamicResource ChromeTextBrush}"/><Run Text="Notes" FontSize="{DynamicResource TitleWordmarkBoldSize}" FontWeight="Bold" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="{DynamicResource CaptionButtonsMargin}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- E8F1 (Library, a row of books): reads as "your notepads". E8B7 renders
                     as a missing-glyph box on some Segoe MDL2 / Fluent Icons versions, and
                     E8E5 (OpenFile) read as a document, not a database.

                     FontSize overrides ChromeButton's 10, which is sized for the caption glyphs
                     and leaves these two reading as specks (2026-07-29). Library is drawn
                     narrower than the padlock, so it needs 16 to match the lock's 14. Same numbers
                     as Killendar's title bar; set locally so Controls.xaml stays byte-identical
                     across the family. -->
                <Button x:Name="DatabasesBtn" Click="ManageDatabases_Click" Style="{StaticResource ChromeButton}"
                        Foreground="{DynamicResource CaptionGlyphBrush}" FontSize="16" Content="&#xE8F1;" ToolTip="{DynamicResource Str_TT_Databases}"/>
                <!-- CaptionAppGroupGap separates the app's own caption buttons (databases, lock)
                     from the window's three (minimize, maximize, close). They are different KINDS
                     of button - one acts on the open file, the other on the window - and with no
                     gap they read as one run of five. Sits on the last app button so the gap
                     belongs to that group. 0 by default. (2026-08-07) -->
                <Button x:Name="LockButton" Click="LockButton_Click" Style="{StaticResource ChromeButton}"
                        Margin="{DynamicResource CaptionAppGroupGap}"
                        Foreground="{DynamicResource CaptionGlyphBrush}" FontSize="14" Content="&#xE72E;" ToolTip="{DynamicResource Str_TT_Lock}"/>
                <!-- Caption glyphs. Segoe MDL2 has no Win98 equivalents - the era's are hand-drawn
                     bitmaps, so no font substitution reaches them and bolding is as close as a
                     glyph gets. Each button therefore carries BOTH: the MDL2 character and a drawn
                     shape, with the theme choosing via CaptionFontGlyphVisibility /
                     CaptionDrawnGlyphVisibility. Defaults keep the font glyph on all twelve other
                     themes; a beveled theme shows the drawn one and hides the character. -->
                <Button x:Name="MinimizeBtn" Foreground="{DynamicResource CaptionGlyphBrush}" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}">
                    <!-- Height pinned to the button. Without it this Grid auto-sizes to its own
                         contents and VerticalAlignment="Bottom" on the bar below has nothing to sit
                         at the bottom of, so the bar rendered dead center no matter what margin it
                         was given - which is exactly what it was doing. -->
                    <Grid Height="{DynamicResource CaptionButtonHeight}">
                        <!-- Centered EXPLICITLY. The Grid's height is pinned for the drawn bar
                             below, and a TextBlock with no alignment stretches to that height and
                             paints its text at the TOP - which put the minimize dash on the top
                             edge of the button on every non-beveled theme. -->
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="{DynamicResource CaptionGlyphWeight}"
                                   Visibility="{DynamicResource CaptionFontGlyphVisibility}"/>
                        <!-- A short thick bar sitting on the BOTTOM of the button, not centered. -->
                        <Rectangle Width="6" Height="2" Fill="{DynamicResource CaptionGlyphBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                   SnapsToDevicePixels="True"
                                   Visibility="{DynamicResource CaptionDrawnGlyphVisibility}"/>
                    </Grid>
                </Button>
                <Button x:Name="MaximizeBtn" Foreground="{DynamicResource CaptionGlyphBrush}" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}">
                    <Grid>
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   FontWeight="{DynamicResource CaptionGlyphWeight}"
                                   Visibility="{DynamicResource CaptionFontGlyphVisibility}"/>
                        <!-- A rectangle with a DOUBLED top edge - the era's title-bar stand-in.
                             1px of bottom margin lifts it off center: a 9px box in a 16px button
                             leaves 3.5px each side, and WPF rounds that down on top, which read as
                             the icon sitting low. -->
                        <Grid Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0,0,0,1"
                              Visibility="{DynamicResource CaptionDrawnGlyphVisibility}" SnapsToDevicePixels="True">
                            <Rectangle Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="1" Fill="Transparent"/>
                            <Rectangle Height="2" Fill="{DynamicResource CaptionGlyphBrush}" VerticalAlignment="Top"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button x:Name="CloseBtn" Click="CloseBtn_Click" Style="{StaticResource ChromeCloseButton}">
                </Button>
            </StackPanel>

        </Grid>

        <!-- ============ Sidebar + editor ============ -->
        <!-- ScaleHost: the app-wide accessibility zoom (AppScale.cs) scales THIS grid only, so
             the title bar and footer stay a fixed size and the logo you scroll to zoom (LogoBar)
             never moves. -->
        <!-- Chrome-colored backing behind the scaled row: at a fractional app zoom the scaled
             content can land a sub-pixel short of the row slot, and the window backdrop showed
             through the seam as a dark stripe above the footer. Backed with the same
             BackgroundBrush the chrome tiers use, a hairline seam is invisible (2026-08-08). -->
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}"/>
        <Grid x:Name="ScaleHost" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="280" MinWidth="230" MaxWidth="480"/>
                <!-- Zero-width popup-anchor lane. RailFlyoutAnchor may render past this point,
                     but it must not reserve space between the 24px rail and the editor pane. -->
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chrome strip behind the whole row: same BackgroundBrush as the title bar and
                 footer, so the sidebar and both bars merge into one chrome surface, and the
                 side margins carry the grain like the other bars (family pattern) -->
            <Border Grid.ColumnSpan="3" Background="{DynamicResource BackgroundBrush}">
                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                        Background="{DynamicResource GrainTileBrush}"/>
            </Border>

            <!-- Sidebar = collapsible panel + permanent icon rail on the CONTENT-PANE lip
                 (KillerPDF pattern: the icons live on the sidebar's inner edge, right next
                 to the document, in both states - they never move on collapse). -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RailCol" Width="24"/>
                </Grid.ColumnDefinitions>

                <!-- RESIZE GRIP, on the notes panel's inner edge so the line sits immediately to
                     the LEFT of the icon rail (family standard, matching KillerShell and
                     KillerPDF). A Thumb rather than a GridSplitter: a splitter resizes the two
                     columns either side of it, and this column's neighbor is the 24px rail, which
                     must never move - so the drag drives SidebarCol by hand and the content column
                     absorbs the change. It also keeps the drag from fighting the collapse
                     animation, which sets that same Width property (Sidebar.cs).
                     ZIndex 50 keeps it above the pane's edge fades whatever the declaration
                     order; 5px wide so the edge is grabbable without hunting for it. -->
                <Thumb x:Name="SidebarResizeGrip" Grid.Column="0" Panel.ZIndex="50"
                       HorizontalAlignment="Right" Width="5" Cursor="SizeWE"
                       DragDelta="SidebarResizeGrip_DragDelta"
                       DragCompleted="SidebarResizeGrip_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <!-- Transparent, not empty: a Border with no Background is not
                                 hit-testable, so the grip would be invisible AND unusable. -->
                            <Border x:Name="grip" Background="Transparent">
                                <Rectangle x:Name="hint" Width="1" HorizontalAlignment="Right"
                                           Fill="{DynamicResource PaneBorderBrush}" Opacity="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                </Trigger>
                                <!-- Grabbed: the line lights to the accent, so the edge you are
                                     dragging is unmistakable while the pointer is off over the
                                     content pane. -->
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                    <Setter TargetName="hint" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- Icon rail on the inner lip: collapse chevron top; ? and theme pinned bottom.
                     The rail column is a constant LOGICAL RailW=24 (Sidebar.cs), so it widens
                     with the app zoom and its scaling icons never clip - and it hugs the
                     20-logical buttons so high zoom doesn't scale up empty air. -->
                <Grid Grid.Column="1">
                    <!-- The asymmetric 2px margin shifts centered elements 1px toward the
                         pane, matching the family rail's optical glyph alignment. -->
                    <Button x:Name="SidebarToggleBtn" Style="{StaticResource RailButton}"
                            Content="&#xE76B;" FontSize="12"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="2,10,0,0"
                            Click="SidebarToggle_Click" ToolTip="{DynamicResource Str_TT_CollapseSidebar}"/>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="2,0,0,6">
                        <!-- Killculator toggle (Killculator.cs / F9). E1D0 = the calculator glyph. -->
                        <Button x:Name="KalcRailBtn" Style="{StaticResource RailButton}" Content="&#xE1D0;"
                                Margin="0,0,0,10" Click="KalcRail_Click"
                                ToolTip="{DynamicResource Str_TT_CalcRail}"/>
                        <!-- SketchPad (Editor.cs InsertSketchPad / F7). E929 = Handwriting. -->
                        <Button x:Name="SketchRailBtn" Style="{StaticResource RailButton}" Content="&#xE929;"
                                Margin="0,0,0,10" Click="SketchRail_Click"
                                ToolTip="{DynamicResource Str_TT_SketchRail}"/>
                        <!-- Dictation (Editor.Dictation.cs / F8). E720 = Microphone. Sits with the
                             other app-specific tools, above the universal ? / language / theme
                             block, per the locked family rail order. -->
                        <Button x:Name="DictationRailBtn" Style="{StaticResource RailButton}" Content="&#xE720;"
                                Margin="0,0,0,10" Click="DictationRail_Click"
                                ToolTip="{DynamicResource Str_TT_DictationRail}">
                            <!-- Right-click: the speech model. The chooser is offered once, the
                                 first time a transcription would otherwise use Windows' engine,
                                 and after that there was NO way back to it - so switching model,
                                 or adding a more accurate one later, was impossible. -->
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str_Whisper_Menu}" Icon="&#xE720;"
                                              Click="SpeechModel_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Find in THIS note (Ctrl+F, FindBar.cs). E721, the plain magnifier, against
                             the sidebar box's E773 global find: same family of action, different scope.
                             Sits with the tool toggles, above the display toggles below it, and lights
                             via Tag="on" while the bar is open like the three toggles above. -->
                        <Button x:Name="FindRailBtn" Style="{StaticResource RailButton}" Content="&#xE721;"
                                Margin="0,0,0,10" Click="FindRail_Click"
                                ToolTip="{DynamicResource Str_TT_FindRail}"/>
                        <!-- Sidebar row density (Density.cs / Ctrl+D): click cycles Comfortable ->
                             Compact -> Minimal, mouse wheel steps through them. E8A1 = the list glyph. -->
                        <Button x:Name="DensityBtn" Style="{StaticResource RailButton}" Content="&#xE8A1;"
                                Margin="0,0,0,10" Click="Density_Click" PreviewMouseWheel="Density_MouseWheel"
                                ToolTip="{DynamicResource Str_TT_Density}"/>
                        <!-- Line-number gutter toggle (LineNumbers.cs / F11). RailButton renders
                             Content AS a glyph (Text=TemplateBinding Content), so this must be
                             Content, not a child element. EA37 = the numbered-list glyph. -->
                        <Button x:Name="LineNumBtn" Style="{StaticResource RailButton}" Content="&#xEA37;"
                                Margin="0,0,0,10" Click="LineNumbers_Click"
                                ToolTip="{DynamicResource Str_TT_LineNumbers}"/>
                        <Button Style="{StaticResource RailButton}" Content="?"
                                FontFamily="Consolas" FontSize="18" Margin="0,0,0,10"
                                Click="ShortcutHelp_Click" ToolTip="{DynamicResource Str_TT_Shortcuts}"/>
                        <!-- F2B7 (LocaleLanguage - globe with characters in front): language picker,
                             opens the locale menu upward (Localization.cs BuildLanguageMenu fills it
                             on click). Family standard, in preference to the bare E774 globe. -->
                        <Button x:Name="LangButton" Style="{StaticResource RailButton}" Content="&#xF2B7;"
                                Margin="0,0,0,10" Click="LangButton_Click"
                                ToolTip="{DynamicResource Str_TT_Language}">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="LangMenu">
                                    <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Grid><Border Style="{StaticResource FlyoutCard}"><Grid><ItemsPresenter/><Border Style="{StaticResource FlyoutGrain}"/></Grid></Border><Border IsHitTestVisible="False" Margin="22,18,22,26" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/><Border IsHitTestVisible="False" Margin="22,18,22,26" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/></Grid></ControlTemplate></ContextMenu.Template>
                                    <ContextMenu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource PanelMenuItem}"/></ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <!-- Theme + accent flyout: deliberately a ContextMenu, the SAME control
                             and themed chrome (grain included) as the locale menu, opened with
                             the SAME placement settings (OpenThemeMenu, ThemeFlyout.cs) - one
                             mechanism, so the two rail flyouts cannot diverge. The single
                             MenuItem's template is a bare ContentPresenter: no menu hover
                             chrome around the swatch panels. -->
                        <Button x:Name="ThemeButton" Style="{StaticResource RailButton}" Content="&#xE790;"
                                Click="SidebarThemeBtn_Click" ToolTip="{DynamicResource Str_TT_Theme}">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ThemeMenu">
                                    <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Grid><Border Style="{StaticResource FlyoutCard}"><Grid><ItemsPresenter/><Border Style="{StaticResource FlyoutGrain}"/></Grid></Border><Border IsHitTestVisible="False" Margin="22,18,22,26" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/><Border IsHitTestVisible="False" Margin="22,18,22,26" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/></Grid></ControlTemplate></ContextMenu.Template>
                                    <ContextMenu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource PanelMenuItem}"/></ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Clip host: during the collapse/expand slide the panel is frozen at full
                     width (Sidebar.cs) and clipped here, so it wipes in/out instead of reflowing. -->
                <Grid Grid.Column="0" ClipToBounds="True">
                <!-- Keyed, not a hardcoded 8. That 8 is the family's breathing room between the
                     window edge and the sidebar, and it is right on a theme whose window edge is a
                     1px line. On a theme with a real 5px sizing frame it STACKS on top of it, so
                     the gray band from the window edge to the content came out at 13-15px instead
                     of 5 - which is what made the sides look tripled. Defaults to the same 8,8,0,0
                     everywhere else. (2026-08-07) -->
                <DockPanel x:Name="SidebarPanel" Margin="{DynamicResource SidebarPanelMargin}">
                    <!-- 8px right inset on the header block (search + New note + sort trio) so it
                         clears the resize grip instead of butting against it. 8 is not arbitrary:
                         the notes list below runs to the panel edge, and its 12px scroll track
                         carries a thumb with Margin="4,0" (Controls.xaml), so the VISIBLE thumb
                         starts exactly 8px in. The header's right edge therefore lines up with the
                         left edge of the scrollbar underneath. The list itself is deliberately not
                         inset - its scrollbar should stay on the panel edge. -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search box (KillerScan pattern): magnifier + placeholder, compact -->
                            <Border Grid.Column="0" Height="26" VerticalAlignment="Center"
                                    Background="{DynamicResource SearchFieldBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                        <Style.Triggers>
                                            <!-- Hover first, focus second so a focused box keeps the accent border -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Sunken edge: the search box is an edit field, and a Win98
                                         edit field is recessed. Crossed against the pane bevel
                                         thicknesses, transparent on the other twelve. Spans both
                                         columns and sits above them so it rings the whole field. -->
                                    <Border Grid.ColumnSpan="2" Panel.ZIndex="2" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                                    <Border Grid.ColumnSpan="2" Panel.ZIndex="2" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                                    <!-- E773, not the E71C filter funnel: this box searches across every
                                         note, so it reads as global find. E721, the plain magnifier, is
                                         reserved for the rail's find-in-this-note toggle. -->
                                    <!-- 14, not 11. The field's height is fixed at 26 on the Border, so
                                         the glyph can grow without the box growing with it. -->
                                    <TextBlock Grid.Column="0" Text="&#xE773;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource DimTextBrush}" Margin="8,0,5,0" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Str_SearchPlaceholder}" Foreground="{DynamicResource DimTextBrush}"
                                                   FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <!-- Empty AND unfocused, not empty alone. On the text
                                                             condition by itself the hint stayed put when the box
                                                             was clicked into, and the caret sits at x=0 - right
                                                             on the S of the hint, which reads as a misplaced
                                                             cursor rather than an empty field. -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                 SelectionBrush="{DynamicResource TextSelectionBrush}" SelectionOpacity="{DynamicResource TextSelectionOpacity}"
                                 SelectionTextBrush="{DynamicResource TextSelectionTextBrush}"
                                                 FontSize="12" Padding="0,0,8,0" VerticalContentAlignment="Center"
                                                 TextChanged="SearchBox_TextChanged">
                                            <!-- Explicit menu: the framework's built-in editing menu ignores the app's
                                                 implicit ContextMenu/MenuItem styles, so it renders unthemed -->
                                            <TextBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{DynamicResource Str_Ctx_Cut}" Icon="&#xE8C6;" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
                                                    <MenuItem Header="{DynamicResource Str_Ctx_Copy}" Icon="&#xE8C8;" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                                                    <MenuItem Header="{DynamicResource Str_Ctx_Paste}" Icon="&#xE77F;" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                                                </ContextMenu>
                                            </TextBox.ContextMenu>
                                        </TextBox>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <!-- Second Auto row: at high app zoom the panel's LOGICAL width shrinks
                             (screen-constant sidebar) and one row can't hold everything - the
                             sort trio then drops under the New-note button instead of clipping
                             (Sidebar.cs SidebarToolbar_SizeChanged). -->
                        <Grid x:Name="SidebarToolbar" Margin="0,8,0,8" SizeChanged="SidebarToolbar_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="NewNoteCol" Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- NO fixed Width. The button must size to whichever label
                                 UpdateNewNoteLabel picked ("+ New note" / "+ New" / "+"): that
                                 step-down exists so the button SHRINKS as the sidebar narrows, and
                                 pinning a width defeats it entirely - the label collapses to "+"
                                 while the button stays put, so it plus the sort trio overrun the
                                 column and clip. MinWidth keeps a bare "+" a comfortable target. -->
                            <Button x:Name="NewNoteBtn" Grid.Column="0" Style="{StaticResource OutlineButton}"
                                    Content="{DynamicResource Str_Btn_NewNote}" Click="NewNote_Click" HorizontalAlignment="Left"
                                    Height="30" MinWidth="34" Padding="14,5" FontSize="13"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ToolTip="{DynamicResource Str_TT_NewNote}"/>
                            <!-- Dedicated sorts: creation time (default, oldest first) and
                                 alphabetical. The active one shows in the accent; clicking it
                                 again reverses its direction (Notes.cs). -->
                            <StackPanel x:Name="SortBtns" Grid.Column="1" Orientation="Horizontal">
                                <!-- Padding 0: SurfaceButton's 12px side padding clips glyphs at
                                     fixed widths. The active button carries a direction arrow
                                     (up = ascending) that flips when clicked again (Notes.cs). -->
                                <Button x:Name="SortTimeBtn" Style="{StaticResource SurfaceButton}"
                                        Background="{DynamicResource SortButtonBrush}"
                                        BorderBrush="{DynamicResource OutlineBtnBrush}"
                                        Margin="8,0,0,0" Click="SortTimeBtn_Click" Width="40" Padding="0"
                                        ToolTip="{DynamicResource Str_TT_SortTime}"
                                        ContextMenu="{StaticResource SortMenu}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SortTimeArrow" Text="&#x2191;" FontFamily="Segoe UI"
                                                   FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SortAlphaBtn" Style="{StaticResource SurfaceButton}"
                                        Background="{DynamicResource SortButtonBrush}"
                                        BorderBrush="{DynamicResource OutlineBtnBrush}"
                                        Margin="6,0,0,0" Click="SortAlphaBtn_Click" Width="40" Padding="0"
                                        ToolTip="{DynamicResource Str_TT_SortAlpha}"
                                        ContextMenu="{StaticResource SortMenu}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="AZ" FontFamily="Consolas" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SortAlphaArrow" Text="" FontFamily="Segoe UI"
                                                   FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <!-- Custom order (#4): manual arrangement, no direction arrow;
                                     dragging a note in any sort switches here (Groups.cs) -->
                                <Button x:Name="SortCustomBtn" Style="{StaticResource SurfaceButton}"
                                        Background="{DynamicResource SortButtonBrush}"
                                        BorderBrush="{DynamicResource OutlineBtnBrush}"
                                        Margin="6,0,0,0" Click="SortCustomBtn_Click" Width="34" Padding="0"
                                        ToolTip="{DynamicResource Str_TT_SortCustom}"
                                        ContextMenu="{StaticResource SortMenu}">
                                    <TextBlock Text="&#xE76F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Notes fill the top; the calculator (when open) takes an auto row
                                 below, so the list shrinks and stays visible above it. -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- The note list's SUNKEN edge - a Win98 list box is recessed into the
                             window face. Row 0 only, so it rings the list and not the calculator
                             below it. ZIndex above the list so the edge draws over its first and
                             last rows the way a real client border does. Transparent by default. -->
                        <Border Grid.Row="0" Panel.ZIndex="5" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                        <Border Grid.Row="0" Panel.ZIndex="5" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                        <!-- Inner half of the two-tone sunken edge; see the content pane. -->
                        <Border Grid.Row="0" Panel.ZIndex="5" IsHitTestVisible="False"
                                Margin="{DynamicResource PaneBevelInnerMargin}"
                                BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                        <Border Grid.Row="0" Panel.ZIndex="5" IsHitTestVisible="False"
                                Margin="{DynamicResource PaneBevelInnerMargin}"
                                BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                    <!-- ListPaneBrush is Transparent by default, so the chrome strip behind the
                         content row shows through and the list blends into the sidebar exactly as
                         it always has. It fills THE LIST ONLY, deliberately: the header above it
                         (search + New note + sort) and the calculator in the row below are controls
                         on the window face, not a client area, and must stay the panel color. -->
                    <ListBox x:Name="NotesList" Background="{DynamicResource ListPaneBrush}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             SelectionChanged="NotesList_SelectionChanged"
                             PreviewMouseRightButtonDown="NotesList_PreviewMouseRightButtonDown"
                             PreviewMouseLeftButtonDown="NotesList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="NotesList_PreviewMouseMove"
                             AllowDrop="True" DragOver="NotesList_DragOver" Drop="NotesList_Drop"
                             DragLeave="NotesList_DragLeave">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Ancestor guide rails (1.1.0 subgroups): one thin vertical line per
                                                         nesting level above this row, each in that ancestor group's color, so a
                                                         parent's line runs down the left of its child subgroups (containment).
                                                         Zero width for top-level rows, so top level looks exactly as before. -->
                                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding Rails}"
                                                                  IsHitTestVisible="False" VerticalAlignment="Stretch">
                                                        <!-- Horizontal stack of 14px level slots; a horizontal StackPanel
                                                             stretches its children to full row height, so the lines are
                                                             continuous (not choppy) down abutting rows. -->
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="14">
                                                                    <!-- 3px line at the ancestor's spine x (8px into the slot); rounds
                                                                         its bottom on the last row of that ancestor's subtree. -->
                                                                    <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource MutedTextBrush}"/>
                                                                                <Setter Property="CornerRadius" Value="0"/>
                                                                                <!-- Margin must live here, not as a local attribute: a local value
                                                                                     outranks the IsLast trigger and would suppress the bottom cap,
                                                                                     leaving the parent rails full-height past the child's capped end. -->
                                                                                <Setter Property="Margin" Value="8,0,0,0"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                                                        <Setter Property="Background" Value="{Binding Brush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                                        <Setter Property="CornerRadius" Value="0,0,1.5,1.5"/>
                                                                                        <Setter Property="Margin" Value="8,0,0,5"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Group spine (#8): a colored line down the left of the group - on the
                                                         header and every child note, capped (rounded, inset) at the group's top
                                                         and bottom so groups don't merge, square + full-height in between so the
                                                         rows join seamlessly. Group color when set, else a muted theme line. It
                                                         replaces the chevron: short on a collapsed header, grown down the notes
                                                         when expanded. -->
                                                    <Border Grid.Column="1" Width="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Background" Value="{DynamicResource MutedTextBrush}"/>
                                                                <Setter Property="CornerRadius" Value="0"/>
                                                                <Setter Property="Margin" Value="8,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowGroupStripe}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasGroupColor}" Value="True">
                                                                        <Setter Property="Background" Value="{Binding GroupColorBrush}"/>
                                                                    </DataTrigger>
                                                                    <!-- The spine caps at the group's top (header) and bottom (last note - or the
                                                                         header itself when collapsed, giving a short pill); middle rows stay
                                                                         square + full-height so they join with no seam. -->
                                                                    <DataTrigger Binding="{Binding IsFirstInGroup}" Value="True">
                                                                        <Setter Property="CornerRadius" Value="1.5,1.5,0,0"/>
                                                                        <Setter Property="Margin" Value="8,5,0,0"/>
                                                                    </DataTrigger>
                                                                    <!-- A nested (subgroup) header's own spine starts just above its own
                                                                         header text (~2px) instead of stretching to the row top, so it never
                                                                         crowds the parent group's name above; the rounded top corner stays.
                                                                         Collapsed pills keep their centered treatment. -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsFirstInGroup}" Value="True"/>
                                                                            <Condition Binding="{Binding IsNested}" Value="True"/>
                                                                            <Condition Binding="{Binding IsLastInGroup}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Margin" Value="8,10.5,0,0"/>
                                                                    </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLastInGroup}" Value="True">
                                                                        <Setter Property="CornerRadius" Value="0,0,1.5,1.5"/>
                                                                        <Setter Property="Margin" Value="8,0,0,5"/>
                                                                    </DataTrigger>
                                                                    <!-- Collapsed pill: a fixed-height, vertically centered bar instead of
                                                                         a stretched line with fixed insets, so it sits centered on the
                                                                         header text regardless of the header font size or density. -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsFirstInGroup}" Value="True"/>
                                                                            <Condition Binding="{Binding IsLastInGroup}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="CornerRadius" Value="1.5"/>
                                                                        <Setter Property="Height" Value="14"/>
                                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                                        <!-- The header's negative bottom margin lets its text overdraw the
                                                                             row bottom, so the visible text center sits ~5px below the cell
                                                                             center; nudge the centered pill down to match. -->
                                                                        <Setter Property="Margin" Value="8,5,0,-5"/>
                                                                        <!-- Collapsed = the line "turns sideways": the vertical pill rotates
                                                                             into a horizontal dash (render-only, so the layout slot and the
                                                                             header text position stay identical to the expanded state).
                                                                             Open runs the line down the notes; closed lays it flat. -->
                                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ContentPresenter Grid.Column="2" Margin="{TemplateBinding Padding}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                </Trigger>
                                                <!-- SelectionBg, not RowSelectedBrush: the row's TEXT
                                                     uses SelectionFg, and those two are a matched
                                                     pair every theme defines together. Pairing the
                                                     fill with a third, unrelated key is how the
                                                     contrast between them drifts per theme. -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <!-- On the ListBox, not the item style: WPF cannot wire Click handlers on
                             elements inside a Style Setter (connectionId cast failure at load).
                             Right-click selects the item under the cursor first (code-behind). -->
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="NotesContextMenu_Opened" Closed="NotesContextMenu_Closed">
                                <MenuItem Header="{DynamicResource Str_Ctx_ShareNote}" Icon="&#xE72D;" Click="ShareNote_Click"
                                          ToolTip="{DynamicResource Str_TT_ShareNote}"/>
                                <MenuItem Header="{DynamicResource Str_Ctx_ExportNote}" Icon="&#xE74E;" Click="ExportNoteAs_Click"
                                          ToolTip="{DynamicResource Str_TT_ExportNote}"/>
                                <!-- One toggle row per defined tag, built on open (Tags.cs) -->
                                <MenuItem x:Name="TagsMenu" Header="{DynamicResource Str_Ctx_Tags}" Icon="&#xE8EC;"/>
                                <!-- One row per group + remove + new, built on open (Groups.cs, #4) -->
                                <MenuItem x:Name="GroupMenu" Header="{DynamicResource Str_Ctx_Group}" Icon="&#xE8B7;"/>
                                <MenuItem Header="{DynamicResource Str_Ctx_TitleColor}" Icon="&#xE8D3;" Click="TitleColorPick_Click"
                                          ToolTip="{DynamicResource Str_TT_TitleColor}"/>
                                <MenuItem Header="{DynamicResource Str_Ctx_TitleColorReset}" Icon="&#xE894;" Click="TitleColorReset_Click"/>
                                <!-- App-wide off switch for the markdown/HTML detection (#14). The
                                     detector itself is the real fix (Preview.cs requires a strong
                                     signal now); this is here for anyone who wants it to stop
                                     guessing entirely. Checked on open by NotesContextMenu_Opened. -->
                                <MenuItem x:Name="PreviewDetectGlobal" Header="{DynamicResource Str_Ctx_PreviewGlobal}"
                                          Icon="&#xE8A1;" IsCheckable="True" Click="PreviewDetectGlobal_Click"
                                          ToolTip="{DynamicResource Str_TT_PreviewGlobal}"/>
                                <MenuItem Header="{DynamicResource Str_Ctx_DeleteNote}" Icon="&#xE74D;" Click="DeleteNote_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Resources>
                            <!-- Implicit typed templates (#4): the composite sidebar list mixes
                                 Note rows and GroupHeader rows; WPF picks by item type. -->
                            <DataTemplate DataType="{x:Type models:GroupHeader}">
                                <!-- Headers are not selectable rows: click toggles collapse,
                                     right-click opens the group menu (both set Handled so the
                                     ListBoxItem never sees the press). Groups.cs. -->
                                <!-- Padding/Margin come from the model so the compact densities
                                     (Ctrl+D) trim the header spacing too, not just the note rows. -->
                                <Border Background="Transparent" Padding="{Binding HeaderPadding}" Margin="{Binding HeaderMargin}"
                                        MouseLeftButtonDown="GroupHeader_Press"
                                        MouseLeftButtonUp="GroupHeader_Click"
                                        MouseRightButtonDown="GroupHeader_RightDown">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{DynamicResource Str_Ctx_NewSubgroup}" Icon="&#xE8F4;" Click="NewSubgroup_Click"
                                                      InputGestureText="Ctrl+Shift+G"/>
                                            <MenuItem Header="{DynamicResource Str_Ctx_SubTop}" Tag="subtop" IsCheckable="True"
                                                      Click="SubgroupsOnTop_Click" ToolTip="{DynamicResource Str_TT_SubTop}"/>
                                            <MenuItem Header="{DynamicResource Str_Ctx_RenameGroup}" Icon="&#xE8AC;" Click="RenameGroup_Click"/>
                                            <MenuItem Header="{DynamicResource Str_Ctx_GroupColor}" Icon="&#xE790;" Click="GroupColorPick_Click"
                                                      Tag="groupcolor" InputGestureText="Ctrl+Shift+K"
                                                      ToolTip="{DynamicResource Str_TT_GroupColor}"/>
                                            <MenuItem Header="{DynamicResource Str_Ctx_GroupColorReset}" Icon="&#xE894;" Click="GroupColorReset_Click"/>
                                            <MenuItem Header="{DynamicResource Str_Ctx_DeleteGroup}" Icon="&#xE74D;" Click="DeleteGroup_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <!-- No chevron: the colored spine (the container line) is the group's
                                         indicator; clicking the header toggles collapse and the line grows down
                                         through the notes / shrinks back to the header. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                                       FontFamily="{DynamicResource HeaderFont}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <!-- Colored per group when NameColor is set; the DataTrigger keeps
                                                     uncolored names on the theme-reactive TextBrush (issue #8) -->
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasColor}" Value="True">
                                                                <Setter Property="Foreground" Value="{Binding NameBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CountDisplay}" FontSize="10" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource DimTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type models:Note}">
                                <StackPanel>
                                    <!-- Colored per note when TitleColor is set; the DataTrigger keeps
                                         uncolored titles on the theme-reactive TextBrush (1.0.1, #1) -->
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource SidebarFont}"
                                               ToolTip="{Binding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <!-- Selected row text rides SelectionFg, the foreground each theme
                                                         pairs with its own selection fill. This was hardcoded #FFFFFF on
                                                         the assumption the fill is always a dark accent, which is true
                                                         of the six original palettes (all of which set SelectionFg to
                                                         #ffffff, so they are unchanged) but not of the palette-lab
                                                         themes: Malaise picks #ead900 as its accent, giving a bright
                                                         yellow row that white text vanishes into. Those themes compute
                                                         SelectionFg from the accent's luminance, so it comes back
                                                         charcoal. First, so a per-note title color (next trigger) still
                                                         wins while the row is selected - a colored title keeps its color. -->
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasTitleColor}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding TitleBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Snippet}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                               FontFamily="{DynamicResource SidebarFont}"
                                               Visibility="{Binding SnippetVisibility}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                                <Style.Triggers>
                                                    <!-- Opacity rather than a baked alpha white, so the snippet keeps its
                                                         step down from the title against a charcoal SelectionFg too. -->
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                        <Setter Property="Opacity" Value="0.91"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ModifiedDisplay}" FontSize="10" Margin="0,1,0,0"
                                               FontFamily="{DynamicResource SidebarFont}"
                                               Visibility="{Binding DateVisibility}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                        <Setter Property="Opacity" Value="0.78"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Tag pills (Services/TagManager.BuildChips); click filters by tag.
                                         Empty chip list renders zero height. -->
                                    <ItemsControl ItemsSource="{Binding Chips}" Visibility="{Binding ChipsVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Background}" CornerRadius="{DynamicResource SmallCornerRadius}" Padding="5,1" Margin="0,3,4,0"
                                                        Cursor="Hand" MouseLeftButtonUp="TagChip_Click"
                                                        ToolTip="{DynamicResource Str_TT_TagChip}">
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"
                                                               FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                    <!-- Top counterpart to NotesFade: appears only after the list has moved away
                         from its first row, matching KillerShell/KillerPDF's bidirectional hint. -->
                    <Border x:Name="NotesTopFade" Height="28" VerticalAlignment="Top" Margin="0,0,12,0"
                            Opacity="{DynamicResource EdgeFadeOpacity}"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Grid>
                            <Border Background="{DynamicResource SurfaceBrush}"/>
                            <Border Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        </Grid>
                    </Border>
                    <!-- Bottom fade overlay: the last rows fade into the chrome while the list
                         overflows and is not at the bottom (Sidebar.cs toggles Visibility). Inset
                         12px on the right to clear the scrollbar. The overlay IS the chrome -
                         BackgroundBrush + the same grain - under a top-transparent to bottom-opaque
                         mask, so it fades into an exact match for the sidebar/footer (never darker,
                         grain intact) rather than a flat black patch. -->
                    <Border x:Name="NotesFade" Height="28" VerticalAlignment="Bottom" Margin="0,0,12,0"
                            Opacity="{DynamicResource EdgeFadeOpacity}"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Grid>
                            <Border Background="{DynamicResource SurfaceBrush}"/>
                            <Border Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        </Grid>
                    </Border>

                    <!-- Killculator (F9): a themed adding-machine docked in the row BELOW the notes
                         list, so the list shrinks and stays visible above it. Opaque + grain to read
                         like the sidebar chrome; its Height animates 0 -> natural (Killculator.cs) so
                         it slides up from the footer. The Print key pushes the readout into the note. -->
                    <!-- Background is Transparent, NOT BackgroundBrush, and there is no grain layer
                         of its own. Painting BackgroundBrush here draws a SECOND copy of it, and on
                         the themes whose background is a gradient that copy starts its ramp at the
                         panel's own edges - so it never lines up with the window behind it and the
                         pad reads as a mismatched block. Transparent lets the real background (and
                         its grain) run straight through. Transparent rather than null: a Border with
                         a null Background receives no mouse input, and this panel is clickable. -->
                    <Border x:Name="KalcPanel" Grid.Row="1" Visibility="Collapsed" ClipToBounds="True"
                            Height="0" VerticalAlignment="Bottom" Background="Transparent"
                            Focusable="True" PreviewMouseDown="KalcPanel_Press">
                        <Grid>
                            <!-- Grip on the pad's top edge: a free vertical STRETCH, height only.
                                 The sidebar is what locks the aspect ratio (Killculator.cs) - the
                                 grip deliberately does not, so the pad can be made taller without
                                 dragging the whole sidebar wider. -->
                            <Thumb x:Name="KalcGrip" Height="5" VerticalAlignment="Top" Panel.ZIndex="50"
                                   Cursor="SizeNS" DragDelta="KalcGrip_DragDelta"
                                   ToolTip="{DynamicResource Str_TT_KalcResize}">
                                <!-- The horizontal twin of SidebarResizeGrip: same 5px band, same
                                     transparent-Border template, same 1px hint line that appears on
                                     hover and lights to the accent while dragging. Without the hint
                                     the band is invisible and you have to hunt for it. -->
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <!-- Transparent, not empty: a Border with no Background is
                                             not hit-testable, so the grip would be unusable. -->
                                        <Border x:Name="grip" Background="Transparent">
                                            <Rectangle x:Name="hint" Height="1" VerticalAlignment="Top"
                                                       Fill="{DynamicResource PaneBorderBrush}" Opacity="0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                                <Setter TargetName="hint" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <!-- Stretch, not Bottom: the content fills whatever height the panel has,
                                 so the keypad row absorbs a grip drag. Deliberately NOT a Viewbox -
                                 that scales the keypad like a picture, which balloons it to fill the
                                 width on open and shrinks it to a thumbnail rather than letting the
                                 buttons flatten. -->
                            <Grid Margin="8,8,8,10" VerticalAlignment="Stretch">
                                <Grid.Resources>
                                    <Style x:Key="KalcBtn" TargetType="Button">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                        <Setter Property="FontSize" Value="17"/>
                                        <Setter Property="Margin" Value="3"/>
                                        <!-- 24, not 42. This is the floor the keypad can compress to
                                             when the pad is dragged shorter; at 42 the five rows have
                                             a hard 210px minimum and the panel clips them instead of
                                             flattening. The UniformGrid stretches them above this. -->
                                        <Setter Property="MinHeight" Value="24"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border x:Name="cb" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                                CornerRadius="{DynamicResource PanelCornerRadius}" SnapsToDevicePixels="True"/>
                                                        <!-- Hover as an accent TINT, not a swap to RowHoverBrush. On 98SE
                                                             RowHoverBrush and SurfaceBrush are the same #d4d0c8, so the
                                                             keypad swapped gray for identical gray and had no hover at all.
                                                             A translucent wash of the theme's own accent is guaranteed to
                                                             read against its surface, so every palette gets the same
                                                             feedback. Opacity is animated by the trigger, not the brush,
                                                             so it costs nothing at rest. -->
                                                        <Border x:Name="hover" Background="{DynamicResource PrimaryBrush}" Opacity="0"
                                                                CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False"/>
                                                        <!-- Content ABOVE the tint, so the wash never muddies the digit. -->
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <!-- Raised edge, the same pair every other button template in the
                                                             family carries. Transparent and zero-thickness on every theme
                                                             but 98SE, so this is inert elsewhere - the keypad was simply
                                                             the one control that never got the layer, which is why its
                                                             keys stayed flat while the rest of 98SE was beveled. -->
                                                        <Border x:Name="bevelLight" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                        <Border x:Name="bevelDark" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="hover" Property="Opacity" Value="0.18"/>
                                                            <Setter TargetName="cb" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="cb" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                                            <!-- Swap the two so the key reads SUNKEN while held, which is
                                                                 the whole point of a bevel on a calculator key. -->
                                                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                                                            <Setter TargetName="bevelDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- Accent keys (= and Print): outline with accent text at rest,
                                         fill solid with on-accent (dark) text on hover/press. Own
                                         template so the base gray hover does not apply. -->
                                    <Style x:Key="KalcBtnAccent" TargetType="Button" BasedOn="{StaticResource KalcBtn}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border x:Name="cb" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                                                CornerRadius="{DynamicResource PanelCornerRadius}" SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border x:Name="bevelLight" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                        <Border x:Name="bevelDark" IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="cb" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="cb" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                                                            <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                                                            <Setter TargetName="bevelDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- Operator / clear keys: accent text via a Setter (not a local
                                         value) so the template's pressed-state on-accent text wins. -->
                                    <Style x:Key="KalcBtnOp" TargetType="Button" BasedOn="{StaticResource KalcBtn}">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Style>
                                </Grid.Resources>
                                <!-- Grid, not StackPanel: only the KEYPAD row is star-sized, so a
                                     grip drag grows or shrinks the buttons while the header, readout
                                     and print row keep their natural heights. A StackPanel gives
                                     every child its natural height and the extra space goes nowhere. -->
                                <Grid>
                                    <!-- No header row. The "Killculator" caption and its close X were
                                         both redundant - the rail's calculator button sits right
                                         beside the pad and toggles it - and the row they occupied is
                                         better spent on the notes list above. -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- readout -->
                                        <RowDefinition Height="*"/>      <!-- keypad, takes the slack -->
                                        <RowDefinition Height="Auto"/>   <!-- print row -->
                                    </Grid.RowDefinitions>
                                    <!-- Readout -->
                                    <!-- Named: Killculator.cs tightens MinHeight/Margin here, and the
                                         display's FontSize, when the pad is dragged short. -->
                                    <!-- PaneBrush, not SurfaceBrush: an LCD readout is a client area, and on a
                                         beveled theme SurfaceBrush is the button-face gray, so the readout was
                                         the same color as the keys around it. PaneBrush is the white client
                                         surface there and the content pane color everywhere else. -->
                                    <Border x:Name="KalcReadout" Grid.Row="0" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" MinHeight="54" Margin="3,0,3,8">
                                        <Grid>
                                            <TextBlock x:Name="KalcDisplay" Text="0" FontFamily="Consolas" FontSize="30"
                                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Margin="14,4" TextTrimming="CharacterEllipsis"/>
                                            <!-- SUNKEN, so the readout reads as a recessed LCD against the raised keys.
                                                 The bevel pair is deliberately CROSSED here: the dark brush takes the
                                                 LIGHT thickness (top/left) and the light brush the DARK one
                                                 (bottom/right). That inversion is what makes a 98SE control look
                                                 pressed into the panel instead of standing out of it - the same swap a
                                                 key performs while it is held. Placed INSIDE the readout border rather
                                                 than wrapped around it, so Killculator.cs can keep setting MinHeight
                                                 and Margin on KalcReadout directly when the pad is dragged short.

                                                 Margin="-1" because of that nesting. KalcReadout has BorderThickness=1,
                                                 so its content area - and therefore an unmargined child - is inset a
                                                 pixel on every side, and the bevel came out 2px short in both
                                                 dimensions, stopping before the corners. The negative margin pushes it
                                                 back out over that 1px band so it rings the control instead of the
                                                 content. Same defect, same fix as the About card's info panel. -->
                                            <Border IsHitTestVisible="False" Margin="-1" BorderBrush="{DynamicResource BevelDarkBrush}"
                                                    BorderThickness="{DynamicResource BevelLightThickness}"/>
                                            <Border IsHitTestVisible="False" Margin="-1" BorderBrush="{DynamicResource BevelLightBrush}"
                                                    BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        </Grid>
                                    </Border>
                                    <!-- Keypad. Star row, so this is what a grip drag resizes. -->
                                    <UniformGrid Grid.Row="1" Rows="5" Columns="4">
                                        <Button Style="{StaticResource KalcBtnOp}" Tag="clear" Click="Kalc_Key" Content="C"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="neg" Click="Kalc_Key" Content="&#x00B1;"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="pct" Click="Kalc_Key" Content="%"/>
                                        <Button Style="{StaticResource KalcBtnOp}" Tag="div" Click="Kalc_Key" Content="&#x00F7;"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="7" Click="Kalc_Key" Content="7"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="8" Click="Kalc_Key" Content="8"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="9" Click="Kalc_Key" Content="9"/>
                                        <Button Style="{StaticResource KalcBtnOp}" Tag="mul" Click="Kalc_Key" Content="&#x00D7;"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="4" Click="Kalc_Key" Content="4"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="5" Click="Kalc_Key" Content="5"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="6" Click="Kalc_Key" Content="6"/>
                                        <Button Style="{StaticResource KalcBtnOp}" Tag="sub" Click="Kalc_Key" Content="&#x2212;"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="1" Click="Kalc_Key" Content="1"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="2" Click="Kalc_Key" Content="2"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="3" Click="Kalc_Key" Content="3"/>
                                        <Button Style="{StaticResource KalcBtnOp}" Tag="add" Click="Kalc_Key" Content="+"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="0" Click="Kalc_Key" Content="0"/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="dot" Click="Kalc_Key" Content="."/>
                                        <Button Style="{StaticResource KalcBtn}" Tag="back" Click="Kalc_Key" Content="&#x232B;"
                                                FontFamily="Segoe UI Symbol"/>
                                        <Button Style="{StaticResource KalcBtnAccent}" Tag="eq" Click="Kalc_Key" Content="="/>
                                    </UniformGrid>
                                    <!-- Print row (slim): = / Enter computes, then Sum (Ctrl+Enter) drops
                                         the readout and Equation (Ctrl+Shift+Enter) drops the whole
                                         running equation into the note. -->
                                    <UniformGrid Grid.Row="2" Columns="2" Margin="3,8,3,0">
                                        <Button Style="{StaticResource KalcBtnAccent}" Tag="print" Click="Kalc_Key"
                                                Height="32" MinHeight="0" Margin="0,0,3,0" ToolTip="{DynamicResource Str_TT_CalcPrintSum}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Str_Btn_CalcPrintSum}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource KalcBtnAccent}" Tag="printeq" Click="Kalc_Key"
                                                Height="32" MinHeight="0" Margin="3,0,0,0" ToolTip="{DynamicResource Str_TT_CalcPrintEq}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Str_Btn_CalcPrintEq}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                </DockPanel>
                </Grid>
            </Grid>


            <!-- Zero-size anchor at (rail right edge + 4px, row bottom). Its grid column is
                 explicitly zero-width, so this 4px positioning margin cannot create a seam
                 between the rail and editor. Both rail flyouts
                 open with built-in Placement=Top against it: popup bottom on the anchor's
                 top, left edges aligned. Pure layout - no custom placement callback, whose
                 device-pixel coordinate space made popup positions drift with DPI and
                 popup size. Only the per-template shadow-halo offsets remain. -->
            <Border x:Name="RailFlyoutAnchor" Grid.Column="1" Width="0" Height="0"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,0"
                    IsHitTestVisible="False"/>

            <!-- Editor pane - the lightest tier, lifted above the chrome with an outward drop
                 shadow, flush to the title bar and footer so the shadow overlays them rather
                 than adding gap (same treatment as the KillerPDF/KillerScan content pane) -->
            <!-- Shadow caster: an empty twin border carries the pane's drop shadow. With
                 software rendering, an Effect on an ancestor re-renders the whole subtree
                 through the effect on every keystroke - typing lag - so the content pane
                 below stays effect-free. -->
            <!-- NO Effect on this pane, ever. The downward cast onto the footer is the gradient
                 band BELOW, drawn as geometry. A DropShadowEffect on a pane-sized element went
                 through every failure mode today: a shared keyed effect's dynamic opacity died
                 with a closed dialog window (shadow gone), through a BitmapCache the blur
                 rendered as a hard 5px stripe, and bare, the shader surface dropped out at some
                 accessibility-zoom scales and not others - gone at 102% magnification, back
                 at 104 (2026-08-08). Geometry cannot do any of that. -->
            <Border x:Name="ContentPane" Grid.Column="2" Background="{DynamicResource PaneBrush}"
                    BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}" Margin="{DynamicResource ContentPaneMargin}" Panel.ZIndex="9"/>
            <!-- The pane's cast onto the footer: a 20px gradient skirt hung into the footer row
                 via RenderTransform (layout-neutral - the rows never move). It shares the
                 pane's column and margins so it tracks the pane's width at every app zoom, and
                 its Opacity IS PaneShadowOpacity, so a flat theme (98SE: 0) removes it
                 entirely - the same key the old effect obeyed. -->
            <Border Grid.Column="2" Height="20" VerticalAlignment="Bottom"
                    Margin="{DynamicResource ContentPaneMargin}" Panel.ZIndex="8"
                    IsHitTestVisible="False"
                    Opacity="{DynamicResource PaneShadowOpacity}">
                <Border.RenderTransform><TranslateTransform Y="20"/></Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A0000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <!-- Feather the ENDS too: a real cast fades at the pane's corners, and without
                     this the band stopped at the pane's right margin as a hard vertical edge
                     across the footer shadow (2026-08-08). -->
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.02"/>
                        <GradientStop Color="#FFFFFFFF" Offset="0.98"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>
            <!-- The pane's SUNKEN edge, drawn over the pane's own border so the client area reads as
                 recessed into the window face - the Notepad/Explorer look. Siblings rather than
                 children of the pane, because a bevel nested inside a bordered element draws inside
                 that border and comes up short (the same defect the Killculator readout had). They
                 carry the pane's margin so they land exactly on it. Both brushes are transparent by
                 default, so this draws nothing on the other twelve themes. -->
            <Border Grid.Column="2" Margin="{DynamicResource ContentPaneMargin}" Panel.ZIndex="11" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
            <Border Grid.Column="2" Margin="{DynamicResource ContentPaneMargin}" Panel.ZIndex="11" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
            <!-- The INNER half of the sunken edge. Win32's EDGE_SUNKEN is two tones - #808080 then
                 #000000 down the top/left, #ffffff then the face color up the bottom/right - and a
                 single 2px gray has the right width with the wrong depth. Transparent at zero
                 thickness by default. (2026-08-07, measured against Notepad) -->
            <Border Grid.Column="2" Margin="{DynamicResource ContentPaneInnerMargin}" Panel.ZIndex="11" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
            <Border Grid.Column="2" Margin="{DynamicResource ContentPaneInnerMargin}" Panel.ZIndex="11" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
            <Border Grid.Column="2" Background="{DynamicResource PaneBrush}"
                    BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}" Margin="{DynamicResource ContentPaneMargin}" Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Film grain over the whole pane (behind content, clipped to the rounded corners) -->
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.20" Panel.ZIndex="-1" CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Border.Background>
                        <ImageBrush x:Name="GrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>

                <!-- Note title + faint rule dividing it from the content -->
                <StackPanel x:Name="TitleArea" Grid.Row="0">
                <TextBox x:Name="TitleBox" Margin="12,10,12,4"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         SelectionBrush="{DynamicResource TextSelectionBrush}" SelectionOpacity="{DynamicResource TextSelectionOpacity}"
                                 SelectionTextBrush="{DynamicResource TextSelectionTextBrush}"
                         FontSize="17" FontWeight="SemiBold"
                         TextChanged="TitleBox_TextChanged"
                         PreviewMouseLeftButtonDown="TitleBox_PreviewMouseLeftButtonDown">
                    <!-- Explicit menu: the framework's built-in editing menu ignores the app's
                         implicit ContextMenu/MenuItem styles, so it renders unthemed -->
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource Str_Ctx_Cut}" Icon="&#xE8C6;" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="{DynamicResource Str_Ctx_Copy}" Icon="&#xE8C8;" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="{DynamicResource Str_Ctx_Paste}" Icon="&#xE77F;" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
                <!-- 0 top / 3 bottom, not 2/0: with no bottom clearance the rule sat on the body
                     text's ascenders (2026-08-08). The title's own 4px bottom margin
                     keeps its descenders clear above. -->
                <Border Height="1" Margin="12,0,12,3" Opacity="0.5"
                        Background="{DynamicResource CardBorderBrush}"/>
                </StackPanel>

                <!-- Floating format bar using the KillerUI annotation-bar contract: pops out of
                     the top beside the title, slides horizontally by its grip (edge-anchored
                     or center-parked, position persisted), and minimizes to a grip-dots peek
                     strip - chevron, F6, or double-click the grip/peek (FormatBar.cs) -->
                <Border x:Name="FormatBar" Grid.Row="0" Panel.ZIndex="30"
                        VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="{DynamicResource BgFlyout}"
                        BorderBrush="{DynamicResource BarEdgeBrush}" BorderThickness="{DynamicResource BarEdgeThickness}"
                        CornerRadius="{DynamicResource FlyoutCornerRadius}" Padding="{DynamicResource BarPadding}"
                        Effect="{StaticResource ShadowBar}">
                    <!-- Cache the bar + its shadow as a bitmap: with software rendering the
                         shadow would otherwise re-render on every keystroke it overlaps -->
                    <Border.CacheMode>
                        <BitmapCache/>
                    </Border.CacheMode>
                    <!-- BarEdge* turn this from a floating card into a Win98 taskbar: a raised strip
                         with a white top/left highlight, so the tool buttons read as sitting ON it.
                         The defaults are the 1px PaneBorderBrush edge the bar has always had, so
                         the other twelve themes are untouched. -->
                <Grid>
                    <!-- Classic raised frame: transparent in modern themes, a 2px light left edge
                         and dark right/bottom edge in 98SE. No top edge by design - the bar hangs
                         off the title bar and is flush there.
                         Margin -2 cancels the bar's Padding="2": without it these sit two pixels
                         inside the bar and the bevel floats away from the edge it is meant to be.
                         The grain overlay below cancels the same padding the same way. -->
                    <Border Panel.ZIndex="20" IsHitTestVisible="False" Margin="-2"
                            BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="2,0,0,0"/>
                    <Border Panel.ZIndex="20" IsHitTestVisible="False" Margin="-2"
                            BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="0,0,2,2"/>
                    <!-- Film grain across the bar, KillerPDF-style; stays put when minimized -->
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource FlyoutCornerRadius}" Margin="-2"
                            Opacity="{DynamicResource GrainOpacity}"
                            Background="{DynamicResource GrainTileBrush}"/>

                    <!-- Invisible grab halo above the peek strip: the strip hugs the native
                         caption boundary (CaptionHeight=36, pane flush below), so a click
                         overshooting by a few px used to land on the title bar (HTCAPTION).
                         IsHitTestVisibleInChrome lets these pixels win inside the caption
                         zone. Shown only while minimized (FormatBar.cs). -->
                    <Border x:Name="FmtPeekHalo" Background="Transparent" Height="8" Margin="0,-8,0,0"
                            VerticalAlignment="Top" Visibility="Collapsed" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{DynamicResource Str_TT_FmtPeek}"/>

                    <!-- Peek strip shown while minimized: click to restore, drag to move -->
                    <Border x:Name="FmtPeek" Background="Transparent" Cursor="Hand" Height="9"
                            Visibility="Collapsed"
                            ToolTip="{DynamicResource Str_TT_FmtPeek}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="3" Height="3" Margin="2,0" Fill="{DynamicResource DimTextBrush}"/>
                            <Ellipse Width="3" Height="3" Margin="2,0" Fill="{DynamicResource DimTextBrush}"/>
                            <Ellipse Width="3" Height="3" Margin="2,0" Fill="{DynamicResource DimTextBrush}"/>
                            <Ellipse Width="3" Height="3" Margin="2,0" Fill="{DynamicResource DimTextBrush}"/>
                            <Ellipse Width="3" Height="3" Margin="2,0" Fill="{DynamicResource DimTextBrush}"/>
                            <Ellipse Width="3" Height="3" Margin="2,0" Fill="{DynamicResource DimTextBrush}"/>
                        </StackPanel>
                    </Border>

                <WrapPanel x:Name="FmtButtons" Orientation="Horizontal" Margin="8,0">
                    <!-- Drag grip (double-click minimizes, like KillerPDF) -->
                    <!-- Vertical 3-dot column, exactly like KillerPDF's MakeBarGrip -->
                    <Border x:Name="FmtGrip" Background="Transparent" Cursor="Hand"
                            Padding="1,0,10,0" VerticalAlignment="Stretch"
                            ToolTip="{DynamicResource Str_TT_FmtGrip}">
                        <Grid IsHitTestVisible="False">
                            <!-- Three dots, the family's grab handle. -->
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{DynamicResource GripDotsVisibility}">
                                <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource DimTextBrush}"/>
                                <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource DimTextBrush}"/>
                                <Ellipse Width="3" Height="3" Margin="0,1.5" Fill="{DynamicResource DimTextBrush}"/>
                            </StackPanel>
                            <!-- The Win98 TASKBAR grab handle: a raised vertical rule running the
                                 full height of the bar - one white line with a gray one beside it -
                                 not a column of dots. That is what sits at the left of every
                                 rebar band in the era, and this bar is styled as a taskbar.
                                 (2026-08-07) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch" Margin="0,3"
                                        Visibility="{DynamicResource GripHatchVisibility}">
                                <Rectangle Width="1" Fill="{DynamicResource BevelLightBrush}"/>
                                <Rectangle Width="1" Fill="{DynamicResource BevelDarkBrush}"/>
                                <Rectangle Width="2" Fill="Transparent"/>
                                <Rectangle Width="1" Fill="{DynamicResource BevelLightBrush}"/>
                                <Rectangle Width="1" Fill="{DynamicResource BevelDarkBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="FmtBoldBtn" Style="{StaticResource FmtButton}" Content="&#xE8DD;" ToolTip="{DynamicResource Str_TT_Bold}"
                            Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button x:Name="FmtItalicBtn" Style="{StaticResource FmtButton}" Content="&#xE8DB;" ToolTip="{DynamicResource Str_TT_Italic}"
                            Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button x:Name="FmtUnderlineBtn" Style="{StaticResource FmtButton}" Content="&#xE8DC;" ToolTip="{DynamicResource Str_TT_Underline}"
                            Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button x:Name="FmtStrikeBtn" Style="{StaticResource FmtButton}" ToolTip="{DynamicResource Str_TT_Strike}" Click="Strike_Click">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontFamily="Segoe UI"
                                   FontSize="14" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="FmtMonoBtn" Style="{StaticResource FmtButton}" Content="&#xE943;" ToolTip="{DynamicResource Str_TT_Mono}"
                            Click="Mono_Click"/>
                    <Rectangle x:Name="FmtFontSeparator" Style="{StaticResource FmtSeparator}"/>
                    <!-- Font size dropdown: shows the selection's size; hover it and SCROLL to
                         step sizes without clicking, or click for the list (Editor.cs).
                         Ctrl+Shift+> / < grow/shrink from the keyboard (Shortcuts.cs). -->
                    <Button x:Name="FontSizeBtn" Style="{StaticResource FmtButton}" Width="36"
                            ToolTip="{DynamicResource Str_TT_FontSize}" Click="FontSizeBtn_Click"
                            PreviewMouseWheel="FontSizeBtn_MouseWheel">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="FontSizePopup" Placement="Bottom" VerticalOffset="4">
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Template>
                                        <ControlTemplate TargetType="MenuItem">
                                            <ContentPresenter ContentSource="Header" Margin="12,6"/>
                                        </ControlTemplate>
                                    </MenuItem.Template>
                                    <MenuItem.Header>
                                        <StackPanel Width="190">
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{DynamicResource Str_Lbl_Size}" Foreground="{DynamicResource DimTextBrush}" FontSize="10"/>
                                                <TextBlock x:Name="FontSizeSliderValue" Text="13" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11"/>
                                            </Grid>
                                            <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="72" Value="13"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    ValueChanged="FontSizeSlider_ValueChanged"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FontSizeText" Text="13" FontFamily="Segoe UI" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                       Margin="3,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle x:Name="FmtColorSeparator" Style="{StaticResource FmtSeparator}"/>
                    <!-- Word-style "A over a color bar" - the bar follows the accent -->
                    <Button x:Name="TextColorBtn" Style="{StaticResource FmtButton}"
                            ToolTip="{DynamicResource Str_TT_TextColor}" Click="TextColorBtn_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ColorPopup" Placement="Bottom" VerticalOffset="4">
                                <MenuItem StaysOpenOnClick="True">
                                    <MenuItem.Template>
                                        <ControlTemplate TargetType="MenuItem">
                                            <ContentPresenter ContentSource="Header" Margin="12,6"/>
                                        </ControlTemplate>
                                    </MenuItem.Template>
                                    <MenuItem.Header>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Lbl_TextColor}" Foreground="{DynamicResource DimTextBrush}" FontSize="10" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ThemeSwatch}" Background="{DynamicResource PrimaryBrush}" Tag="accent" Click="FgSwatch_Click" ToolTip="{DynamicResource Str_TT_AccentSwatch}"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#DD504B" Tag="#DD504B" Click="FgSwatch_Click"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#E8962C" Tag="#E8962C" Click="FgSwatch_Click"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#1ea54c" Tag="#1ea54c" Click="FgSwatch_Click"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#50AEE8" Tag="#50AEE8" Click="FgSwatch_Click"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#9a9a9a" Tag="#9a9a9a" Click="FgSwatch_Click"/>
                                                <Button Content="{DynamicResource Str_Btn_Auto}" Style="{StaticResource SurfaceButton}" FontSize="10"
                                                        Padding="6,1" Margin="6,0,0,0" Click="FgAuto_Click" ToolTip="{DynamicResource Str_TT_Auto}"/>
                                                <Button Content="{DynamicResource Str_Btn_More}" Style="{StaticResource SurfaceButton}" FontSize="10"
                                                        Padding="6,1" Margin="4,0,0,0" Click="FgMore_Click" ToolTip="{DynamicResource Str_TT_MoreColors}"/>
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource Str_Lbl_Highlight}" Foreground="{DynamicResource DimTextBrush}" FontSize="10" Margin="0,8,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#7a6a00" Tag="#7A6A00" Click="BgSwatch_Click"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#0a5e2a" Tag="#0A5E2A" Click="BgSwatch_Click"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#084d6e" Tag="#084D6E" Click="BgSwatch_Click"/>
                                                <Button Style="{StaticResource ThemeSwatch}" Background="#6e1414" Tag="#6E1414" Click="BgSwatch_Click"/>
                                                <Button Content="{DynamicResource Str_Btn_None}" Style="{StaticResource SurfaceButton}" FontSize="10"
                                                        Padding="6,1" Margin="6,0,0,0" Click="BgNone_Click" ToolTip="{DynamicResource Str_TT_None}"/>
                                                <Button Content="{DynamicResource Str_Btn_More}" Style="{StaticResource SurfaceButton}" FontSize="10"
                                                        Padding="6,1" Margin="4,0,0,0" Click="BgMore_Click" ToolTip="{DynamicResource Str_TT_MoreColors}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel>
                            <TextBlock Text="A" FontFamily="Segoe UI" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,0,0,1"/>
                            <Rectangle Width="14" Height="3" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource PrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle x:Name="FmtListSeparator" Style="{StaticResource FmtSeparator}"/>
                    <Button x:Name="FmtBulletsBtn" Style="{StaticResource FmtButton}" Content="&#xE8FD;" ToolTip="{DynamicResource Str_TT_Bullets}"
                            Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button x:Name="FmtNumberingBtn" Style="{StaticResource FmtButton}" Content="&#xEA37;" ToolTip="{DynamicResource Str_TT_Numbering}"
                            Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}"/>
                    <Rectangle x:Name="FmtInsertSeparator" Style="{StaticResource FmtSeparator}"/>
                    <Button x:Name="FmtRuleBtn" Style="{StaticResource FmtButton}" Content="&#xE738;" ToolTip="{DynamicResource Str_TT_Rule}"
                            Click="InsertRule_Click"/>
                    <!-- Press (or press-hold-drag) opens the size picker grid; release or click
                         on a cell inserts that rows x cols table (Editor.cs). -->
                    <Button x:Name="TableBtn" Style="{StaticResource FmtButton}" Content="&#xE8A9;"
                            ToolTip="{DynamicResource Str_TT_Table}"
                            PreviewMouseLeftButtonDown="TableBtn_MouseDown"/>
                    <Popup x:Name="TableSizePopup" PlacementTarget="{Binding ElementName=TableBtn}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                        <Border Background="{DynamicResource MenuBackgroundBrush}"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="10,8" Margin="12">
                            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55"/></Border.Effect>
                            <StackPanel>
                                <UniformGrid x:Name="TableSizeCells" Columns="8"/>
                                <TextBlock x:Name="TableSizeLabel" Text="{DynamicResource Str_Lbl_Size}" Foreground="{DynamicResource DimTextBrush}"
                                           FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <!-- Custom size for anything beyond the hover grid -->
                                <Border Height="1" Background="{DynamicResource MenuBorderBrush}" Margin="0,8,0,8"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBox x:Name="TblColsBox" Style="{StaticResource DarkTextBox}" Text="4"
                                             Width="34" FontSize="11" Padding="4,2" KeyDown="TblCustom_KeyDown"
                                             ToolTip="{DynamicResource Str_TT_Columns}"/>
                                    <TextBlock Text=" x " Foreground="{DynamicResource DimTextBrush}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TblRowsBox" Style="{StaticResource DarkTextBox}" Text="3"
                                             Width="34" FontSize="11" Padding="4,2" KeyDown="TblCustom_KeyDown"
                                             ToolTip="{DynamicResource Str_TT_Rows}"/>
                                    <Button Content="{DynamicResource Str_Btn_Insert}" Style="{StaticResource SurfaceButton}"
                                            FontSize="11" Padding="8,2" Margin="8,0,0,0"
                                            Click="TblCustomInsert_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <!-- Insert an image from a file (Editor.cs); paste and drag-and-drop are the other two ways in.
                         Icon = the SketchPad's own add-image picture (framed photo + mountain + sun), drawn as shapes
                         (the plain E91B glyph read as a bare rectangle) and theme-reactive via TextBrush. -->
                    <Button x:Name="FmtImageBtn" Style="{StaticResource FmtButton}" ToolTip="{DynamicResource Str_TT_InsertImage}"
                            Click="InsertImageBtn_Click">
                        <!-- Viewbox scales the 16px drawing down to the 14px glyph size so it sits level with the font icons. -->
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="16" Height="16">
                                <Rectangle Width="16" Height="13" RadiusX="1.5" RadiusY="1.5" StrokeThickness="1.4"
                                           Stroke="{DynamicResource TextBrush}" Canvas.Left="0" Canvas.Top="1.5"/>
                                <Polygon Points="1,13 6,7.5 9.5,11 11.5,9 15,13" Fill="{DynamicResource TextBrush}"/>
                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextBrush}" Canvas.Left="3" Canvas.Top="4"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Rectangle x:Name="FmtEndSeparator" Style="{StaticResource FmtSeparator}"/>
                    <Button Style="{StaticResource FmtButton}" Content="&#xE70E;" FontSize="10"
                            ToolTip="{DynamicResource Str_TT_HideBar}" Click="FormatBarToggle_Click"/>
                </WrapPanel>
                </Grid>
                </Border>

                <!-- The note body. Content is stored as a XamlPackage blob, so pasted
                     images and real FlowDocument tables round-trip through the database.
                     The right column is the optional markdown/HTML preview (Preview.cs),
                     collapsed until the user opens it.
                     Named because the floating find bar (FindBar.cs) is positioned and
                     clamped against this area's bounds. -->
                <Grid x:Name="EditorArea" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="GutterCol" Width="0"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="PreviewCol" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <!-- Line-number gutter (LineNumbers.cs): a Canvas whose numbers are positioned to
                         each paragraph; GutterCol stays 0-wide until the gutter is toggled on. -->
                    <Canvas x:Name="LineGutter" Grid.Column="0" ClipToBounds="True" Margin="2,0,0,8"/>
                    <RichTextBox x:Name="Editor" Grid.Column="1" Padding="8,0,8,8"
                                 FontFamily="{DynamicResource ContentFont}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 SelectionBrush="{DynamicResource TextSelectionBrush}" SelectionOpacity="{DynamicResource EditorSelectionOpacity}"
                                 SelectionTextBrush="{DynamicResource TextSelectionTextBrush}"
                                 FontSize="13" FontWeight="Normal" AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextChanged="Editor_TextChanged">
                        <RichTextBox.Resources>
                            <!-- The default ScrollViewer corner (where the H and V scrollbars meet, shown
                                 with word wrap off) fills with SystemColors.ControlBrush - a light gray that
                                 reads as a white square on the dark theme. Make it transparent so the note
                                 pane behind shows through instead of a bright block. -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                            <!-- Hyperlinks (Links.cs, 1.1.3): accent-colored and theme-reactive.
                                 NormalizeElement clears the baked link-blue on load/paste so this
                                 implicit style always wins; Ctrl+Click opens (tooltip = target). -->
                            <Style TargetType="Hyperlink">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="{Binding NavigateUri, RelativeSource={RelativeSource Self}}"/>
                            </Style>
                            <!-- Tight paragraphs: a WPF RichTextBox spaces paragraphs by default,
                                 which reads as a blank line between every typed line (glaring once
                                 line numbers are on). Margin 0 single-spaces them like a code
                                 editor; the horizontal-rule paragraph and tables set their own
                                 local margins, so those keep their spacing. -->
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                                <!-- Make the body weight concrete in copied RTF/XAML. Browsers
                                     otherwise sometimes resolve WPF's inherited default as bold;
                                     an intentionally bold Run still overrides this setter. -->
                                <Setter Property="FontWeight" Value="Normal"/>
                            </Style>
                        </RichTextBox.Resources>
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <ContextMenu.Resources>
                                    <!-- Editor menu only: its commands and shortcuts are already
                                         self-explanatory, so it does not need the roomier family
                                         padding used by nested/sidebar menus. -->
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Padding" Value="4,5,6,5"/>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="{DynamicResource Str_Ctx_Cut}" Icon="&#xE8C6;" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"/>
                                <MenuItem Header="{DynamicResource Str_Ctx_Copy}" Icon="&#xE8C8;" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="{DynamicResource Str_Ctx_Paste}" Icon="&#xE77F;" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                                <MenuItem x:Name="ConvertListMenuItem"
                                          Header="{DynamicResource Str_Ctx_ConvertList}" Icon="&#xE8FD;" Click="ConvertToList_Click"
                                          InputGestureText="Ctrl+Shift+J" ToolTip="{DynamicResource Str_TT_ConvertList}"/>
                                <!-- Insert on empty selection, edit/remove with the caret in a link (Links.cs) -->
                                <MenuItem x:Name="LinkMenuItem"
                                          Header="{DynamicResource Str_Ctx_Link}" Icon="&#xE71B;" Click="LinkMenu_Click"
                                          InputGestureText="Ctrl+K"/>
                                <MenuItem x:Name="DocToggleSeparator" IsHitTestVisible="False" Focusable="False" Height="9">
                                    <MenuItem.Template>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border Height="1" Margin="10,4" Background="{DynamicResource MenuBorderBrush}"/>
                                        </ControlTemplate>
                                    </MenuItem.Template>
                                </MenuItem>
                                <MenuItem x:Name="SyntaxHighlightMenuItem"
                                          IsCheckable="True" Click="SyntaxHighlight_Click"
                                          InputGestureText="Ctrl+Shift+E">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="16">
                                                <TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Str_KS_Syntax}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="WordWrapMenuItem"
                                          IsCheckable="True" Click="WordWrap_Click"
                                          InputGestureText="Ctrl+Shift+W">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="16">
                                                <TextBlock Text="&#x21B5;" FontFamily="Segoe UI Symbol" FontSize="15"
                                                           TextAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Str_KS_WordWrap}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="SpellCheckMenuItem"
                                          IsCheckable="True" Click="Spell_Click"
                                          InputGestureText="Ctrl+Shift+P">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="16">
                                                <TextBlock Text="abc" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource Str_KS_Spell}"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="PreviewMenuItem" IsCheckable="True"
                                          Click="TogglePreview_Click" Visibility="Collapsed">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="20" Height="16">
                                                <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           TextAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="PreviewMenuLabel" Text="Preview"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <!-- Recording actions (Editor.Dictation.cs). Collapsed unless the
                                     right-click landed on an embedded recording chip. -->
                                <MenuItem x:Name="RecSeparator" IsHitTestVisible="False" Focusable="False"
                                          Height="9" Visibility="Collapsed">
                                    <MenuItem.Template>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border Height="1" Margin="10,4" Background="{DynamicResource MenuBorderBrush}"/>
                                        </ControlTemplate>
                                    </MenuItem.Template>
                                </MenuItem>
                                <MenuItem x:Name="RecEditMenuItem" Icon="&#xE70F;"
                                          Header="{DynamicResource Str_Dict_EditRec}" Click="RecEdit_Click"
                                          Visibility="Collapsed"/>
                                <MenuItem x:Name="RecShareMenuItem" Icon="&#xE72D;"
                                          Header="{DynamicResource Str_Dict_Share}" Visibility="Collapsed">
                                    <MenuItem x:Name="RecSaveAsMenuItem" Icon="&#xE74E;"
                                              Header="{DynamicResource Str_Dict_SaveAs}" Click="RecSaveAs_Click"/>
                                    <MenuItem x:Name="RecCopyFileMenuItem" Icon="&#xE8C8;"
                                              Header="{DynamicResource Str_Dict_CopyFile}" Click="RecCopyFile_Click"/>
                                </MenuItem>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>
                    <!-- The WebBrowser (IE ActiveX) child is created lazily on first preview
                         open and disposed on close (Preview.cs) - a hosted IE control adds
                         message-loop overhead to the whole window just by existing. -->
                    <!-- SurfaceBrush, matching the format bar: a step darker than the note pane
                         (PaneBrush) and a step lighter than the window (BackgroundBrush), so the
                         preview reads as chrome beside the paper rather than as more paper. The
                         rendered page carries the same color and the same film grain (Preview.cs
                         GrainDataUri) - the hosted browser is a native window, so the grain has to
                         be baked into the HTML rather than layered over it as everywhere else. -->
                    <Border x:Name="PreviewPane" Grid.Column="2" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1,0,0,0"
                            Margin="0,0,8,8"/>
                </Grid>

                <!-- ══════════ IN-NOTE FIND BAR (FindBar.cs) ══════════ -->
                <!-- A free-floating card over the note body, the same shape as KillerPDF's
                     search bar: grabbed by its six-dot grip and dragged anywhere inside the
                     editor, its spot persisted and clamped back inside when the pane resizes.
                     Position is Left/Top margin from EditorArea's top-left corner, which is
                     why it is a sibling of the editor rather than a docked row of its own.
                     ZIndex 40 puts it above the FormatBar's 30 - Ctrl+F must never come up
                     underneath the format toolbar.
                     Collapsed at Opacity 0 until Ctrl+F fades it in (FindBar.cs). -->
                <Border x:Name="FindBar" Grid.Row="1" Panel.ZIndex="40"
                        Visibility="Collapsed" Opacity="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0"
                        Background="{DynamicResource BgFlyout}"
                        BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                    <Border.Effect>
                        <!-- Radius and shadow follow the theme rather than KillerPDF's literals.
                             ControlCornerRadius, NOT PanelCornerRadius: the content pane this card
                             floats on is itself a ControlCornerRadius, so a PanelCornerRadius card
                             is a 6 sitting on a 4 and its corners will not nest into the pane's.
                             KillerPDF has no flat theme; 98SE zeroes FlyoutShadowOpacity and sets
                             PanelCornerRadius to 0, so hardcoding 6 and 0.55 would leave this the
                             one rounded, shadowed surface on a square, flat theme. -->
                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3"
                                          Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                    </Border.Effect>
                    <Grid>
                        <!-- 12,10 = the old 8,6 content margin plus the card's former 4px padding.
                             The padding moved here so the bevel rings below can sit on the card's
                             real edge instead of 4px inside it. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,10,12,10">
                            <!-- Drag grip: two columns of three dots, the family's grab handle.
                                 Transparent yet hit-testable so it can be grabbed. -->
                            <Border x:Name="FindGrip" Background="Transparent" Cursor="SizeAll"
                                    VerticalAlignment="Stretch" Margin="2,0,6,0"
                                    ToolTip="{DynamicResource Str_TT_FindGrip}">
                                <Grid IsHitTestVisible="False">
                                    <!-- Family dot grip. Hidden on 98SE, which grabs a band by the
                                         rebar lines below instead; every other theme leaves
                                         GripDotsVisibility unresolved, so this stays Visible. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{DynamicResource GripDotsVisibility}">
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <Ellipse Width="3" Height="3" Margin="1.5" Fill="{DynamicResource MutedTextBrush}"/>
                                            <Ellipse Width="3" Height="3" Margin="1.5" Fill="{DynamicResource MutedTextBrush}"/>
                                            <Ellipse Width="3" Height="3" Margin="1.5" Fill="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                            <Ellipse Width="3" Height="3" Margin="1.5" Fill="{DynamicResource MutedTextBrush}"/>
                                            <Ellipse Width="3" Height="3" Margin="1.5" Fill="{DynamicResource MutedTextBrush}"/>
                                            <Ellipse Width="3" Height="3" Margin="1.5" Fill="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- The Win98 rebar gripper, the same pair of raised rules the
                                         format bar's grip uses, so the two bars grab the same way.
                                         BevelLightBrush and BevelDarkBrush exist only in 98SE, so
                                         off that theme these rules have no fill and the dots above
                                         are what shows. -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch" Margin="0,2"
                                                Visibility="{DynamicResource GripHatchVisibility}">
                                        <Rectangle Width="1" Fill="{DynamicResource BevelLightBrush}"/>
                                        <Rectangle Width="1" Fill="{DynamicResource BevelDarkBrush}"/>
                                        <Rectangle Width="2" Fill="Transparent"/>
                                        <Rectangle Width="1" Fill="{DynamicResource BevelLightBrush}"/>
                                        <Rectangle Width="1" Fill="{DynamicResource BevelDarkBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <!-- Width is re-fitted to the note body's width (FindBar.cs) so the
                                 card can never overflow it; 220 is the starting size. -->
                            <!-- The same field treatment as the sidebar search box: a filled box
                                 inside its own border, rather than bare text on the bar. -->
                            <Border Height="26" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Background="{DynamicResource SearchFieldBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                        <Style.Triggers>
                                            <!-- Hover first, focus second so a focused box keeps the accent border -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Sunken edge, crossed against the pane bevel thicknesses so a
                                         Win98 edit field is recessed. Transparent on the other twelve. -->
                                    <Border Panel.ZIndex="2" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                                    <Border Panel.ZIndex="2" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                                    <TextBox x:Name="FindBox" VerticalAlignment="Center" Width="220"
                                             Background="Transparent" BorderThickness="0" FontSize="12"
                                             Padding="6,0,6,0" VerticalContentAlignment="Center"
                                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                             SelectionBrush="{DynamicResource TextSelectionBrush}"
                                             SelectionOpacity="{DynamicResource TextSelectionOpacity}"
                                             TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"/>
                                </Grid>
                            </Border>

                            <!-- "3 of 47", or the no-matches line. Consolas so the number stops
                                 jittering the buttons sideways as it counts up, and a fixed width
                                 so the floating card never resizes as the count changes. -->
                            <TextBlock x:Name="FindCountText" VerticalAlignment="Center"
                                       Width="72" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="8,0,8,0" FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource DimTextBrush}"/>

                            <Button Content="&#xE70E;" Click="FindPrev_Click"
                                    Style="{StaticResource RailButton}" FontSize="12" Width="26" Height="24"
                                    ToolTip="{DynamicResource Str_TT_FindPrev}"/>
                            <Button Content="&#xE70D;" Click="FindNext_Click"
                                    Style="{StaticResource RailButton}" FontSize="12" Width="26" Height="24"
                                    ToolTip="{DynamicResource Str_TT_FindNext}"/>
                            <!-- The shared caption X: the glyph and the red hover live in the
                                 style, so this close matches every other close in the app. -->
                            <Button Click="FindClose_Click" Style="{StaticResource DialogCloseButton}"
                                    Width="26" Height="24" VerticalAlignment="Center"
                                    ToolTip="{DynamicResource Str_TT_FindClose}"/>
                        </StackPanel>
                        <!-- Film grain over the row and hit-test invisible: under the content it
                             would be painted over by any solid fill above it. -->
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}"
                                Background="{DynamicResource GrainTileBrush}"/>
                        <!-- Win98 EDGE_RAISED, the same double ring the ContextMenu draws: white
                             over black on the outside, #dfdfdf over #808080 within. One ring alone
                             reads as a line with a highlight rather than a raised surface, which is
                             what makes the bar sit up off the page like a taskbar. Every other
                             theme leaves these brushes transparent at zero thickness, so this is
                             invisible anywhere but 98SE. Inner ring first, outer ring last. -->
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevelLightBrush}"
                                BorderThickness="{DynamicResource MenuBevelLightThickness}"
                                Margin="{DynamicResource MenuBevelInnerMargin}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevelDarkBrush}"
                                BorderThickness="{DynamicResource MenuBevelDarkThickness}"
                                Margin="{DynamicResource MenuBevelInnerMargin}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2LightBrush}"
                                BorderThickness="{DynamicResource MenuBevel2LightThickness}"/>
                        <Border IsHitTestVisible="False" BorderBrush="{DynamicResource MenuBevel2DarkBrush}"
                                BorderThickness="{DynamicResource MenuBevel2DarkThickness}"/>
                    </Grid>
                </Border>

                <!-- Shown when no note is selected. Clicking starts a new note; dropped
                     text or images start a new note carrying them (Notes.cs / Editor.cs). -->
                <Grid x:Name="EmptyState" Grid.Row="0" Grid.RowSpan="2" Background="Transparent"
                      Cursor="IBeam" AllowDrop="True"
                      MouseLeftButtonDown="EmptyState_MouseDown"
                      DragOver="EmptyState_DragOver" Drop="EmptyState_Drop">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource DimTextBrush}" FontSize="13"
                               Text="{DynamicResource Str_EmptyHint}"/>
                </Grid>
            </Grid>
            </Border>
        </Grid>

        <!-- Status bar (exact copy of KillerScan's: 24px, Consolas 11.5/10, family standard) -->
        <!-- ZIndex -1 so the content pane's shadow lands on the footer rather than being painted
             over by it. The footer is pushed down rather than the content row raised, which would
             also put it above the overlays declared later. -->
        <Border Grid.Row="2" Panel.ZIndex="-1" Background="{DynamicResource BackgroundBrush}">
            <Grid>
            <!-- The status bar's own SLIGHT recess. Win98 status bars are sunk a hair into the
                 window face - much shallower than a client area, which is why this is its own
                 thickness key rather than reusing the pane bevel. Drawn under the content Grid so
                 the text sits inside it. Transparent and 0 by default: the other twelve themes get
                 no edge at all and the footer is exactly as it was. -->
            <!-- A Win98 status bar is not a strip with a line drawn on it - it is a row of SUNKEN
                 CELLS, and what looks like a divider is the gap between two of them. The cells are
                 the two Grids below, wrapping the status text and the version block. Everything
                 here is transparent/0 by default, so the other twelve keep a flat, plain footer. -->
            <!-- The family inset is 16px. A Win98 status bar has its cells hard against the window
                 edge, so a beveled theme drops this to almost nothing - otherwise the sunken cell
                 starts 16px in and leaves dead space in the bottom-left corner. -->
            <Grid Margin="{DynamicResource FooterPadding}">
                <Grid.ColumnDefinitions>
                    <!-- Status cell takes ALL the leftover width; the version cell is Auto so it
                         hugs its text. This was * / Auto / *, which split the bar in half and left
                         the status cell ending in the middle of the footer with dead space after
                         it - visible the moment the cell gained a sunken edge. -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Film grain over the bar (negative margin pulls it to the full width) -->
                <Border Grid.ColumnSpan="3" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="-16,0">
                    <Border.Background>
                        <ImageBrush x:Name="StatusGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <!-- Cell 1: the status text. The bevels are SIBLINGS of the text inside this Grid,
                     crossed (dark on the light thickness) so the cell reads as pressed in. -->
                <Grid Grid.Column="0" Margin="{DynamicResource FooterCellMargin}">
                    <TextBlock x:Name="StatusText" Text="{DynamicResource Str_St_Ready}"
                               Foreground="{DynamicResource TextFooter}" FontFamily="Consolas"
                               FontSize="11.5" VerticalAlignment="Center"
                               Margin="{DynamicResource FooterCellPadding}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                </Grid>
                <!-- Portable mode indicator (hidden when installed), same as KillerScan.
                     Grid.Column 0, NOT 1: the middle column went Auto when the footer became
                     sunken cells, so anything in it hugs the version cell instead of centering.
                     Riding the star-width status column keeps the badge centered in the bar. -->
                <StackPanel x:Name="PortableBadge" Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Portable}" Foreground="{DynamicResource TextFooter}"
                               FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="InstallBtn" Content="{DynamicResource Str_Btn_Install}" Click="Install_Click"
                            Style="{StaticResource OutlineButton}" FontFamily="Segoe UI" FontSize="10" Padding="8,1"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Cell 2: the version + copyright block, its own sunken cell. The visible gap
                     between this and the status cell IS the divider - Win98 never drew a standalone
                     rule there, which is why the two 1px lines I tried first looked nothing like
                     it. FooterCellMargin supplies that gap. -->
                <!-- HorizontalAlignment=Right so the cell HUGS the version + copyright instead of
                     stretching across the remaining width. That puts the separator immediately to
                     the left of the version, and gives the status cell all the room it needs. -->
                <Grid Grid.Column="2" HorizontalAlignment="Right" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}" Panel.ZIndex="2"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}" Panel.ZIndex="2"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="{DynamicResource FooterCellPadding}">
                    <TextBlock x:Name="VersionLabel" Text="v1.1.7"
                               Foreground="{DynamicResource TextFooter}" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"
                               Cursor="Hand" ToolTip="{DynamicResource Str_TT_About}"
                               MouseLeftButtonUp="VersionLabel_Click"/>
                    <!-- 14px trailing margin keeps the copyright clear of the corner grip (family standard) -->
                    <TextBlock FontSize="10" VerticalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,14,0">
                        <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextFooter}"/>
                        <Hyperlink NavigateUri="https://thekiller.net"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource TextFooter}" TextDecorations="None">
                            <Run Text="Steve the Killer"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                </Grid>
            </Grid>
            </Grid>
        </Border>

        <!-- KillerUI bottom-right resize grip (6 dots). Sits at the visible
             content corner and forwards a HTBOTTOMRIGHT resize to Windows on drag. -->
        <Canvas x:Name="ResizeGripDots" Grid.Row="2" Width="13" Height="13" Panel.ZIndex="50"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                Background="Transparent" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseDown">
            <!-- The family's six dots. GripDotsVisibility is Visible on every theme that does not
                 declare a Win98-style caption, so the locked family grip standard is untouched. -->
            <Canvas Visibility="{DynamicResource GripDotsVisibility}">
                <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            </Canvas>
            <!-- The Win98 grip: three diagonal bands running bottom-left to top-right, each a gray
                 line with a white line below and right of it so the band reads as a beveled ridge.
                 Drawn as Rectangles rotated 45 degrees rather than Lines, because a 1px diagonal
                 Line antialiases into a soft gray smear and this theme has no antialiasing anywhere
                 else. SnapsToDevicePixels keeps them crisp. Collapsed unless the theme asks. -->
            <Canvas Visibility="{DynamicResource GripHatchVisibility}">
                <Canvas.Resources>
                    <Style TargetType="Line">
                        <Setter Property="StrokeThickness" Value="1"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                    </Style>
                </Canvas.Resources>
                <!-- Three parallel diagonal ridges filling the corner triangle, each a gray line
                     with a white one below and right of it so it reads as a beveled ridge rather
                     than a scratch. Continuous LINES, not a grid of squares: an earlier attempt
                     placed 2x2 blocks on the same coordinates as the six dots, which just drew the
                     dots again with highlights. The .5 offsets put each stroke on a pixel center so
                     a 1px diagonal stays crisp instead of smearing across two rows. -->
                <Line X1="12.5" Y1="3.5"  X2="3.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="4.5"  X2="4.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="6.5"  X2="6.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="7.5"  X2="7.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="9.5"  X2="9.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="10.5" X2="10.5" Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
            </Canvas>
        </Canvas>

        <!-- The window frame itself now lives in FrameHost, OUTSIDE RootGrid - see the comment on
             FrameHost at the top of this file. It used to be four RowSpan=3 overlays right here,
             painting over the content instead of sitting beside it. -->

        <!-- About overlay: dims the window behind it and shows a centered card (structure copied
             from KillerScan; the close X is blended into the card with a red hover). -->
        <!-- OverlayBleed: the negative of WindowFramePadding. This grid lives inside the content
             row, which is inset for the window frame, so without it the dim stops short and the
             frame stays bright - a lit 5px ring around a dimmed window. 0 when there is no frame. -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="3" Panel.ZIndex="9000" Visibility="Collapsed"
              Margin="{DynamicResource OverlayBleed}"
              Background="#88000000" MouseLeftButtonDown="AboutOverlay_Click">
            <!-- No fixed width: the SHA-256 line never wraps, so it sizes the info panel and
                 the info panel sizes the card. The header below pins its width to that panel
                 so a long tagline wraps instead of widening the card. Family standard. -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="AboutCard_Click">
                <!-- Shadow on a separate element so the card text stays crisp -->
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- caption band, 0px unless the theme wants one -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Film grain over the whole card (behind content) -->
                        <Border Grid.RowSpan="2" IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <!-- Caption band. AboutCaptionHeight is 0 on every theme that does not set
                             UseDialogCaption, so the card is unchanged there and nothing shifts;
                             98SE gets its green gradient and a Win98-style title. ClipToBounds so
                             the title cannot spill out of a zero-height band. Same DialogTitleBarBrush
                             the sketch pad, color picker and file dialog already use. -->
                        <!-- AboutCaptionMargin insets the band from the card edge. 0 by default;
                             98SE sets 2,2,2 so a sliver of face color shows between its overdrawn
                             2px bevel and the caption on left, top and right - see the comment on
                             the key in Themes/KillerUI/98SE.xaml. AboutCloseMargin is derived from
                             this margin in ThemeManager so the X follows the band. -->
                        <Border Grid.Row="0" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource DialogTitleBarBrush}">
                            <!-- Identical to the main window's plain caption title: same family, size,
                                 weight and brush. It was 12pt in the default UI font, which is why the
                                 About caption did not match the dialogs or the title bar. -->
                            <TextBlock Text="{DynamicResource Str_About_Title}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>

                        <!-- Close X. Uses the shared caption-close style so it is a real beveled
                             button inside the caption band on a Win98-style theme, and the same
                             bare glyph it has always been everywhere else (CaptionButtonBrush is
                             transparent there). Width/Height are local: the card's caption is
                             shorter than the main window's, so it must not inherit the 44px slot. -->
                        <!-- E8BB, the same MDL2 glyph the main window's and the dialogs' close buttons
                             use. This was a bare U+2715 in Segoe UI, which is why the icon looked
                             different from every other close button in the app. No local FontFamily
                             or FontSize either - the style supplies both. -->
                        <!-- RowSpan 2, NOT Row 0. Row 0 is Auto and holds the caption band, which is
                             0px high on every theme that does not ask for a caption - but a Grid
                             child still MEASURES into an Auto row, so this button's own height plus
                             its margin inflated that row to ~22px and put a tall empty band above
                             the card on all twelve of those themes. Spanning both rows takes it out
                             of the measurement; AboutCloseMargin already positions it correctly
                             from the card's top edge in both cases. (2026-08-07) -->
                        <Button Grid.RowSpan="2" Click="AboutClose_Click" Style="{StaticResource DialogCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Margin="{DynamicResource AboutCloseMargin}" Panel.ZIndex="2">
                            <!-- The SAME dual glyph as the title bar's close, so every X in the app
                                 is the same X. This was a bare MDL2 character, which meant the main
                                 window switched to the drawn shape on a beveled theme and the card
                                 kept the font one. DialogChrome.CloseGlyph builds the identical pair
                                 for SketchPad, Dictation and the rest. -->
                        </Button>

                        <StackPanel Grid.Row="1" Margin="18,10,18,18">
                            <!-- Header: icon left of the wordmark + description (KillerScan layout).
                                 Width is pinned to the info panel so the SHA-256 line stays the only
                                 thing that sets the card width. -->
                            <Grid Margin="0,4,0,14" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Resources/kn-icon.png" Width="58" Height="58"
                                       Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                                    </Image.Effect>
                                </Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left">
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource IconShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="2"/></TextBlock.Effect><Run Text="Killer" FontSize="22" Foreground="#C0000000"/><Run Text="Notes" FontSize="28.6" FontWeight="Bold" Foreground="#C0000000"/></TextBlock>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}"><Run Text="Killer" FontSize="22" Foreground="{DynamicResource TextBrush}"/><Run Text="Notes" FontSize="28.6" FontWeight="Bold" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Str_About_DescA}"/><Hyperlink NavigateUri="https://killertools.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Killer Tools</Hyperlink><Run Text="{DynamicResource Str_About_DescB}"/></TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Info panel - context-menu fill and grain, lifted above the card. Named:
                                 the header binds its width to this panel (see above). -->
                            <Grid x:Name="AboutInfoGrid">
                                <Border Background="{DynamicResource AboutPanelBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <!-- ONE tone, 1px. This is a grouping box on a card, not a client
                                     area - Win98 gives it the shallowest recess it has, the same
                                     one a status-bar cell gets. The full two-tone PaneBevel* pair
                                     belongs to things you scroll and type into (the notes list, the
                                     editor, the file list); putting it here drew a black rule with
                                     a gray one beside it and read as two stripes rather than an
                                     edge. (2026-08-07) -->
                                <Border Panel.ZIndex="3" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                        BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                                <Border Panel.ZIndex="3" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                        BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                                <!-- Same fill as a context menu, film grain included. The padding moved
                                     off the Border onto the StackPanel so the grain tile covers the panel
                                     edge to edge instead of stopping at the padding. Grain sits BEHIND the
                                     text here, not over it as in a menu template - there is no selection
                                     fill to cover it, and Consolas at 11 stays crisp underneath nothing. -->
                                <!-- PaneEdgeBrush, not PaneBorderBrush: on a beveled theme the
                                     sunken bevel above IS this panel's edge, and drawing the flat
                                     1px line as well gave it three pixels of border - which is why
                                     adding the bevel made the card look heavier rather than
                                     better. Defaults to PaneBorderBrush. (2026-08-07) -->
                                <Border Background="{DynamicResource AboutPanelBrush}" BorderBrush="{DynamicResource PaneEdgeBrush}"
                                        BorderThickness="{DynamicResource AboutPanelBorderThickness}"
                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                  <Grid>
                                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                            Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                                    <StackPanel Margin="14,12,14,4">
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <!-- One row, two ends: version accent left, release date muted and
                                                 italic hard right. Bottom-aligned so the two sizes share a
                                                 baseline. Only the version text is clickable. -->
                                            <Grid Margin="0,1,0,0">
                                                <TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}"
                                                           FontFamily="Consolas" FontSize="13" Cursor="Hand"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                           MouseLeftButtonUp="AboutVersion_Click"/>
                                                <TextBlock x:Name="AboutReleaseDateBlock" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontFamily="Consolas" FontSize="11" FontStyle="Italic"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutPublisherBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,1,0,0"/>
                                            <!-- Shown only on an exe signed by Steve. The alias is an accent link to
                                                 thekiller.net; "AKA" stays muted so the eye lands on the name. -->
                                            <TextBlock x:Name="AboutAkaBlock" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,3,0,0"><Run Text="AKA "/><Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None" ToolTip="thekiller.net"><Run x:Name="AboutAkaRun"/></Hyperlink></TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutThumbprintBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Sha}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutSha256Block" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- SUNKEN bevel: the brushes are crossed relative to a raised
                                         control - dark on the top/left, light on the bottom/right -
                                         which is how Win98 drew a recessed client area. The same swap
                                         Controls.xaml does on a pressed button. Transparent and
                                         zero-thickness on the other twelve themes, so it draws nothing. -->
                                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                                            BorderThickness="4,4,0,0"/>
                                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                  </Grid>
                                </Border>
                            </Grid>

                            <!-- Update notice: shown only when a newer release is found -->
                            <Button x:Name="AboutUpdateButton" Visibility="Collapsed" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand" Click="AboutUpdateButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ub" Background="Transparent" BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,7">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ub" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="AboutUpdateText" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Bevels as siblings of the card, so they land on its outer edge. Transparent and
                     zero-thickness in every theme except 98SE, where they are the card's edge. -->
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
            </Grid>
        </Grid>

        <!-- Fonts overlay (Fonts.cs): three user-swappable slots - Headers (group titles,
             Killculator title), Sidebar (note titles), and Note text (the editor default).
             Same card chrome as the shortcuts overlay; drop a .ttf/.otf on the card to
             import it. -->
        <Grid x:Name="FontsOverlay" Grid.RowSpan="3" Panel.ZIndex="9200" Visibility="Collapsed"
              Margin="{DynamicResource OverlayBleed}"
              Background="#88000000" MouseLeftButtonDown="FontsOverlay_Click">
            <Grid MinWidth="400" MaxWidth="400" VerticalAlignment="Center"
                  MouseLeftButtonDown="FontsCard_Click" AllowDrop="True" Drop="FontsCard_Drop">
                <!-- Radius and shadow follow the theme, not hardcoded 6 / 0.6: a square-cornered
                     flat palette was getting a rounded card with a drop shadow. -->
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource WindowEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- caption band, 0px unless the theme wants one -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                        <!-- Caption band - the SAME recipe as the About card: 98SE gets its
                             gradient and a plain Win98 title, every other theme gets a 0px band
                             and nothing shifts. (2026-08-08) -->
                        <Border Grid.Row="0" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource DialogTitleBarBrush}">
                            <TextBlock Text="{DynamicResource Str_Fonts_Title}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>
                        <!-- The shared caption close, replacing the last hand-rolled ✕ in the app -
                             every X is now the same X. RowSpan 2, NOT Row 0: a child still measures
                             into an Auto row (see the About card's note). -->
                        <Button Grid.RowSpan="2" Click="FontsClose_Click" Style="{StaticResource DialogCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Margin="{DynamicResource AboutCloseMargin}" Panel.ZIndex="2"/>
                        <StackPanel Grid.Row="1" Margin="18,14,18,18">
                            <!-- Inner title hides when the caption band already says it (flat
                                 themes) - WordmarkVisibility is the existing fancy-vs-flat switch. -->
                            <TextBlock Text="{DynamicResource Str_Fonts_Title}" Foreground="{DynamicResource TextBrush}"
                                       FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"
                                       Visibility="{DynamicResource WordmarkVisibility}"/>
                            <TextBlock Text="{DynamicResource Str_Fonts_Headers}" Foreground="{DynamicResource DimTextBrush}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FontHeaderCombo" Style="{StaticResource KnCombo}" Height="26"
                                      SelectionChanged="FontCombo_Changed" PreviewMouseWheel="FontCombo_Wheel">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontFamily="{Binding Fam}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- Fixed preview heights: fonts differ wildly in line height, and a
                                 resizing card made wheel-browsing feel like the window was jumping -->
                            <TextBlock Text="{DynamicResource Str_Fonts_PrevHead}" FontFamily="{DynamicResource HeaderFont}"
                                       FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                       Height="30" ClipToBounds="True"
                                       Margin="2,7,0,14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{DynamicResource Str_Fonts_Sidebar}" Foreground="{DynamicResource DimTextBrush}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FontSidebarCombo" Style="{StaticResource KnCombo}" Height="26"
                                      SelectionChanged="FontCombo_Changed" PreviewMouseWheel="FontCombo_Wheel">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontFamily="{Binding Fam}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Str_Fonts_PrevSidebar}" FontFamily="{DynamicResource SidebarFont}"
                                       FontSize="13" Foreground="{DynamicResource TextBrush}"
                                       Height="24" ClipToBounds="True"
                                       Margin="2,7,0,14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{DynamicResource Str_Fonts_Content}" Foreground="{DynamicResource DimTextBrush}"
                                       FontSize="10" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FontContentCombo" Style="{StaticResource KnCombo}" Height="26"
                                      SelectionChanged="FontCombo_Changed" PreviewMouseWheel="FontCombo_Wheel">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontFamily="{Binding Fam}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Str_Fonts_PrevText}"
                                       FontFamily="{DynamicResource ContentFont}" FontSize="13"
                                       Height="44" ClipToBounds="True"
                                       Foreground="{DynamicResource TextBrush}" Margin="2,7,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Str_Fonts_DropHint}" Foreground="{DynamicResource DimTextBrush}"
                                       FontSize="10.5" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Str_Fonts_Note}" Foreground="{DynamicResource DimTextBrush}"
                                       FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <Button Content="{DynamicResource Str_Fonts_Reset}" Click="FontsReset_Click"
                                    Style="{StaticResource OutlineButton}" FontSize="11" Padding="10,4"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Bevels as siblings of the card, so they land on its outer edge. -->
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
            </Grid>
        </Grid>

        <!-- Shortcuts overlay (F1): same card language as About; mutually exclusive with it -->
        <Grid x:Name="ShortcutOverlay" Grid.RowSpan="3" Panel.ZIndex="9100" Visibility="Collapsed"
              Margin="{DynamicResource OverlayBleed}"
              Background="#88000000" MouseLeftButtonDown="ShortcutOverlay_Click">
            <!-- Stretch WITH a margin, never bare. With no Margin the card runs flush to the
                 window edges, which puts the close X hard into the corner on top of the resize
                 zone - it reads as misaligned and is awkward to hit. The margin also keeps the
                 keyboard map off the window edge on a narrow window. -->
            <Grid x:Name="ShortcutCardGrid" MinWidth="380" Margin="40,32,40,32"
                  VerticalAlignment="Center" MouseLeftButtonDown="ShortcutCard_Click">
                <!-- Radius and shadow follow the theme, not hardcoded 6 / 0.6: a square-cornered
                     flat palette was getting a rounded card with a drop shadow. -->
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource WindowEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                        <!-- Close X: a direct child of the card grid (matches the working About overlay)
                             so it sits at the card's top-right corner and always receives the click. -->
                        <Button Content="&#x2715;" Click="ShortcutClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="26" Margin="0,6,6,0" Panel.ZIndex="2" FontSize="11"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#E04444"/>
                                                        <Setter TargetName="cp" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Margin="18,14,18,18">
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource Str_KS_Title}" Foreground="{DynamicResource TextBrush}"
                                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"/>
                                <!-- LIST / KEYBOARD view toggle (KeyboardMap.cs) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,36,0">
                                    <Button x:Name="KsViewListBtn" Style="{StaticResource KsTabBtn}"
                                            Content="{DynamicResource Str_KS_ViewList}" Click="KsViewList_Click" Margin="0,0,12,0"/>
                                    <Button x:Name="KsViewKeyboardBtn" Style="{StaticResource KsTabBtn}"
                                            Content="{DynamicResource Str_KS_ViewKeyboard}" Click="KsViewKeyboard_Click"/>
                                </StackPanel>
                            </Grid>
                            <!-- Rows are built in code (Shortcuts.cs BuildShortcutRows). Two columns keep
                                 the ~48-row list inside the card instead of running off the bottom. -->
                            <Grid x:Name="ShortcutListHost">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel x:Name="ShortcutColLeft"  Width="300"/>
                                    <StackPanel x:Name="ShortcutColRight" Width="300" Margin="20,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <!-- KEYBOARD view - generated by KeyboardMap.cs, hidden until toggled -->
                            <StackPanel x:Name="ShortcutKeyboardHost" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Bevels as siblings of the card, so they land on its outer edge. -->
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelLightBrush}"
                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                <Border IsHitTestVisible="False" BorderBrush="{DynamicResource BevelDarkBrush}"
                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
            </Grid>
        </Grid>
    </Grid>

    <!-- ============ Window frame ============
         Siblings of RootGrid in FrameHost, not overlays inside it, so the 5px edge occupies its
         OWN space instead of painting over the caption, the sidebar and the footer. Each layer is
         inset past the one outside it: a Border draws its edge inside its own bounds, so without
         the margins these all anchor to pixel 0 and simply cover each other.

         All four default to a transparent brush at zero thickness, so a theme that says nothing
         draws nothing here and its window edge is exactly as it was. -->
    <Border Panel.ZIndex="9001" IsHitTestVisible="False"
            BorderBrush="{DynamicResource FrameOuterLightBrush}"
            BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
    <Border Panel.ZIndex="9001" IsHitTestVisible="False"
            BorderBrush="{DynamicResource FrameOuterDarkBrush}"
            BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
    <!-- The frame FACE. No Background - a Border's Background fills its whole AREA, not its edge,
         and setting one here painted over the entire window. -->
    <Border Panel.ZIndex="8999" IsHitTestVisible="False"
            Margin="{DynamicResource WindowFrameMargin}"
            BorderBrush="{DynamicResource WindowFrameBrush}"
            BorderThickness="{DynamicResource WindowFrameThickness}"/>
    <!-- FrameInner*, NOT the shared Bevel* keys: a window's inner edge and a BUTTON's edge are not
         the same measurement, and pointing both at Bevel* dragged the button bevel along with any
         change to the frame. Defaults to the Bevel* pair. -->
    <Border Panel.ZIndex="9000" IsHitTestVisible="False"
            Margin="{DynamicResource FrameInnerMargin}"
            BorderBrush="{DynamicResource FrameInnerLightBrush}"
            BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
    <Border Panel.ZIndex="9000" IsHitTestVisible="False"
            Margin="{DynamicResource FrameInnerMargin}"
            BorderBrush="{DynamicResource FrameInnerDarkBrush}"
            BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
    </Grid>
    </Border>
</Window>
